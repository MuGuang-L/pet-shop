/* KIGI illustrated cafe — warm paper, cocoa ink, honey accents. */
page{background:#fff8eb;color:#624632;font-family:"Arial Rounded MT Bold","PingFang SC","Microsoft YaHei",sans-serif;--td-brand-color:#a85a32;--td-brand-color-light:#f7e5ca;--td-text-color-primary:#624632;--td-text-color-secondary:#8b715b;--td-bg-color-container:#fffdf6;--td-bg-color-page:#fff8eb;--td-component-stroke:#edddc5;--td-radius-default:16rpx;--td-button-primary-bg-color:#a85a32;--td-button-primary-border-color:#a85a32;--td-tab-item-active-color:#a85a32;--td-tab-track-color:#c3834c}
.shell{padding:0 30rpx 220rpx}
.heading,.headline,.section-title,.brand-wordmark,.cafe-menu-copy>view,.pet-gates>view>view>view,.account-heading>.heading,.center-heading,.empty-title,.member-entry-card view>view{font-family:KigiTitle,"Arial Rounded MT Bold","PingFang SC",sans-serif;font-weight:400;letter-spacing:1rpx;color:#68452d}
.brand{padding:28rpx 0 24rpx}.brand-left{width:100%;gap:24rpx;min-width:0}.brand-logo-frame{position:relative;width:160rpx;height:80rpx;flex:0 0 160rpx;overflow:hidden;border:0;background:transparent}.brand-logo-frame .brand-logo{position:absolute;display:block;width:220rpx;height:220rpx;left:-30rpx;top:-70rpx;border:0;border-radius:0;box-shadow:none}.brand .brand-wordmark{flex:1;min-width:0}.brand-wordmark>view{font-size:30rpx;line-height:1.4;letter-spacing:0}.brand-wordmark .brand-caption{font-size:19rpx;font-family:"PingFang SC",sans-serif;font-weight:400;letter-spacing:3rpx;color:#96775e;margin-top:5rpx}
.hero{height:440rpx;border:1rpx solid #efdfc6;border-radius:32rpx;background:#fff5df;box-shadow:0 8rpx 24rpx #7d4a1710}.hero .hero-image{width:100%;height:100%;object-fit:cover}.hero-copy{top:36rpx;left:28rpx;width:45%}.hero-copy .eyebrow{font-size:16rpx;letter-spacing:1rpx;color:#9e704d}.hero-copy .headline{font-size:44rpx;line-height:1.4;letter-spacing:1rpx;margin:23rpx 0 14rpx;white-space:pre-line}.hero-subtitle{font-size:20rpx;line-height:1.6;color:#8b6a51;display:block}.hero-button{font-size:21rpx!important;padding:15rpx 22rpx!important;min-height:62rpx!important;margin-top:24rpx!important;background:#a85a32!important;box-shadow:0 4rpx 0 #87452220;border-radius:30rpx!important;color:#fffaf0!important}
.benefits{font-size:20rpx;color:#94755d;border:0;padding:24rpx 0;letter-spacing:1rpx}.benefits text::before{content:'·';margin-right:12rpx;color:#c9975a}
.cafe-menu-card{min-height:170rpx;margin:4rpx 0 26rpx;padding:22rpx 24rpx;gap:20rpx;border:1rpx solid #e9cb9e;background:#f6e1b9;border-radius:30rpx;box-shadow:0 5rpx 0 #edd5b1;color:#704627}.cafe-menu-doodle{width:112rpx;height:112rpx;flex-shrink:0;transform:rotate(-5deg);border-radius:25rpx}.cafe-menu-copy>view{font-size:37rpx;line-height:1.6}.cafe-menu-copy>text{font-size:20rpx;color:#8b6849}.cafe-menu-copy>text.cafe-menu-kicker{font-size:13rpx;letter-spacing:1.8rpx;color:#9b744a}.cafe-menu-arrow{font-size:34rpx;color:#9a6338}
.pet-gates{gap:20rpx;margin:28rpx 0 32rpx}.pet-gates>view,.pet-gates>view:nth-child(2){height:180rpx;padding:24rpx 18rpx;background:#fff7e6;border:1rpx solid #ead9bd;border-radius:28rpx;overflow:hidden}.pet-gates>view>view{max-width:62%;position:relative;z-index:1}.pet-gates>view>view>view{font-size:31rpx}.pet-gates text{font-size:20rpx;color:#a4876a;margin-top:10rpx}.pet-gates image{width:142rpx;height:155rpx;right:-3rpx;bottom:0;opacity:1}
.section-heading{margin:34rpx 0 16rpx}.section-heading .heading{font-size:36rpx}.section-heading>text{font-size:22rpx;color:#a17b58}.muted,.panel>text,.sheet>text{color:#8b7561}.home-products{margin-top:22rpx;gap:20rpx}.card,.panel,.address-card,.fulfillment-card,.purchase-card{border:1rpx solid #eddfca;border-radius:28rpx;background:#fffdf7;box-shadow:0 5rpx 16rpx #72502c06}.card image{background:#fff7e6;border-radius:26rpx 26rpx 0 0}.card-copy{padding:18rpx 20rpx}.title,.purchase-name{font-family:"Arial Rounded MT Bold","PingFang SC",sans-serif;font-size:27rpx;font-weight:600;color:#644a36;letter-spacing:0}.tag{background:#f5e9d7;color:#987456;border-radius:12rpx;font-size:19rpx}.price{font-size:36rpx;color:#a85a32;font-weight:700;letter-spacing:0}.add-small{border-radius:50%;background:#f3dfbb;color:#92592e}.new-shelf{background:#f6ecdc;border:1rpx solid #eddfca;border-radius:30rpx;padding:6rpx 20rpx 24rpx;margin-top:30rpx}
.nav{left:20rpx;right:20rpx;bottom:12rpx;border:1rpx solid #e9d6b7;border-radius:32rpx;background:#fffaf1;box-shadow:0 -4rpx 24rpx #784b1910;padding:13rpx 10rpx calc(10rpx + env(safe-area-inset-bottom))}.nav button{font-size:21rpx;color:#96785c;gap:3rpx;min-height:92rpx}.nav image{width:58rpx;height:58rpx;padding:0 15rpx;border-radius:19rpx}.nav .active{color:#9a502b;font-weight:600}.nav .active image{background:#f3dfb9}.nav button::after{display:none}
button{background:#f5e9d6;color:#755136;border-radius:24rpx;font-weight:500}button[disabled]{opacity:.5}.primary{background:#a85a32!important;color:#fffaf0!important;border-radius:26rpx!important;box-shadow:0 4rpx 0 #87482520}.black{background:#765033;color:#fff9ed}.text-link,.text-button{color:#a16d45}.panel{padding:28rpx}.sheet{background:#fff9ee;border-radius:36rpx 36rpx 0 0}.overlay{background:#49322155}input,textarea{background:#fffdf6;border:1rpx solid #e7d8c2;border-radius:22rpx;color:#634a36}input::placeholder,textarea::placeholder{color:#aa937c}
.sidebar{background:#f6eddd;border-radius:0 24rpx 24rpx 0}.sidebar button{color:#91785e}.sidebar .chosen{background:#fff8eb;color:#9e5c32;border-left-color:#dca25b}.product-list .card{box-shadow:none;border-bottom:1rpx dashed #e9dac4}.product-list .card image{border-radius:24rpx;background:#fff7e6}.buyer-tools{color:#8c745d}.coffee-pickup-caption{background:#f9edda;border:1rpx dashed #dfbf91;color:#98704c;border-radius:18rpx}
.empty{padding:24rpx 10rpx 44rpx}.empty image{height:340rpx;width:100%;border-radius:32rpx}.empty-title{font-size:34rpx;margin:12rpx 0}.empty button{background:#eecd96;color:#7a4c2d}.account-heading{position:relative;padding:36rpx 0 30rpx;min-height:120rpx}.account-heading .heading{font-size:43rpx;margin:12rpx 0}.account-heading>text{font-size:22rpx;color:#a08469}.account-mascot{position:absolute;right:0;top:8rpx;width:155rpx;height:155rpx;border-radius:40rpx}.member-entry-card{border:1rpx solid #bd8850;background:#805334;border-radius:28rpx;box-shadow:0 6rpx 0 #edddc3;padding:25rpx;gap:22rpx}.member-entry-card view>view{color:#fff1d6;font-size:34rpx}.member-doodle{width:102rpx;height:102rpx;flex-shrink:0;border:0;border-radius:24rpx;transform:rotate(-5deg)}.account-orders{border:1rpx solid #e9d8bd}.service-pair>button{background:#fffdf6;border:1rpx solid #e9d8bd;border-radius:25rpx}.service-pair image,.order-quick image{border-radius:16rpx}.wallet-card{background:#f7e1b9;border:1rpx solid #e4c493;border-radius:28rpx;color:#7b5335}.wallet-entry{border-bottom:1rpx dashed #e7d8bd}.recharge-tiers button{background:#fff5e1;border:1rpx solid #d8b482;border-radius:22rpx}.wallet-terms{color:#8b745c}
.purchase-status,.purchase-amount{color:#a65b33}.purchase-head,.purchase-footer{border-color:#ecdfcb}.purchase-action{border-radius:24rpx;background:#f5e6cf;color:#956137}.purchase-action-primary{background:#a85a32;color:#fff9ed}.order-detail-bar,.support-bar{background:#fff9ee;border-color:#e9dbc5}.pickup-time-picker{background:#fff3dc;border:1rpx dashed #cfab76;color:#8f6038}.pickup-time-badge{background:#f6e7c9;color:#94613a}.checkout-summary,.store-ticket{background:#fbf0dd;border-color:#ead8b7}.delivery-event-current .delivery-event-dot{background:#b9753f;border-color:#b9753f;box-shadow:0 0 0 6rpx #f5e5cc}.delivery-event-current .delivery-event-title,.delivery-event-current .delivery-event-time{color:#a36a3f}.center-empty-art{display:block;width:300rpx;height:260rpx;margin:12rpx auto 18rpx;border-radius:28rpx}

.cozy-services{margin:26rpx 0;border:1rpx solid #ead9be;border-radius:26rpx;overflow:hidden;background:#fffdf6}.cozy-services button{display:flex;align-items:center;gap:20rpx;width:100%;margin:0;padding:22rpx 24rpx;background:transparent;border-radius:0;border-bottom:1rpx solid #efe4d2;text-align:left;font-size:27rpx;font-weight:400}.cozy-services button:last-child{border-bottom:0}.cozy-services image{width:48rpx;height:48rpx;border-radius:12rpx}.cozy-services .cozy-chevron{margin-left:auto;font-size:36rpx;color:#b48e67}

/* Draw navigation arrows without platform emoji fonts. */
.ui-arrow{display:inline-block;position:relative;box-sizing:border-box;width:28rpx;height:28rpx;flex:0 0 28rpx;vertical-align:middle;pointer-events:none}.ui-arrow::before{content:"";position:absolute;left:2rpx;top:13rpx;width:26rpx;height:2rpx;background:currentColor;transform:rotate(-45deg);transform-origin:center}.ui-arrow::after{content:"";position:absolute;right:3rpx;top:3rpx;box-sizing:border-box;width:15rpx;height:15rpx;border-top:2rpx solid currentColor;border-right:2rpx solid currentColor}.service-pair .ui-arrow{position:absolute;margin:0}.member-entry-card>.ui-arrow{color:#f6dfb7;margin:0}

/* Consistent light surfaces; selected tab stays legible without a dark tile. */
.service-pair>button,.service-pair>button:nth-child(2){background:#fffdf6;border-color:#e9d8bd}
.nav .active image{background:#fff3dc}
.brand-logo{mix-blend-mode:normal}
