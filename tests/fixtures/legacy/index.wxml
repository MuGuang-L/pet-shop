<view class="shell">
 <view class="notice">{{mode === 'local' ? '本地模拟 · MongoDB · 不发生真实付款' : (mode === 'mock' ? '开发模拟模式 · 不发生真实付款' : 'CloudBase 模式 · 真实支付尚未配置')}}</view>
 <view class="brand"><view class="brand-left"><view class="brand-mark">w</view><view>爪爪小铺<text>LITTLE PAWS STORE</text></view></view><text class="store-tag">单店自营</text></view>
 <view class="nav"><button class="{{tab === 'catalog' ? 'active' : ''}}" data-tab="catalog" bindtap="tab"><image src="/assets/nav-home.png"/>首页</button><button class="{{tab === 'category' ? 'active' : ''}}" data-tab="category" bindtap="tab"><image src="/assets/nav-category.png"/>宠物百货</button><button class="{{tab === 'cart' ? 'active' : ''}}" data-tab="cart" bindtap="tab"><image src="/assets/nav-cart.png"/>购物车 {{cart.length || ''}}</button><button class="{{tab !== 'catalog' && tab !== 'category' && tab !== 'cart' ? 'active' : ''}}" data-tab="account" bindtap="tab"><image src="/assets/nav-account.png"/>个人中心</button></view>
 <view wx:if="{{busy}}" class="notice">正在处理，请稍候…</view>
 <block wx:if="{{tab === 'catalog' || tab === 'category'}}">
  <block wx:if="{{tab === 'catalog'}}"><view class="hero"><image class="hero-image" src="{{storefront.hero}}" mode="aspectFill"/><view class="hero-copy"><text class="eyebrow">LITTLE PAWS, BIG LOVE</text><view class="headline home-headline">{{homeContent.headline}}</view><text class="hero-subtitle">{{homeContent.subtitle}}</text><button class="hero-button" data-value="全部" bindtap="browseCategory">挑一份喜欢的 →</button></view></view><view class="benefits"><text>用心选好物</text><text>单店自营</text><text>把日常过得可爱</text></view><view class="pet-gates"><view data-value="猫咪" bindtap="goPet"><view><text class="eyebrow">FOR CATS</text><view>猫咪的小天地</view><text>一起去逛逛 →</text></view><image src="{{storefront.cat}}" mode="aspectFill"/></view><view data-value="狗狗" bindtap="goPet"><view><text class="eyebrow">FOR DOGS</text><view>狗狗的快乐清单</view><text>一起去逛逛 →</text></view><image src="{{storefront.dog}}" mode="aspectFill"/></view></view><view class="section-heading"><view><text class="eyebrow">LITTLE DAILY RITUALS</text><view class="heading">照顾它的每个小日常</view></view></view><view class="scene-grid"><view wx:for="{{homeContent.scenes}}" wx:key="key" data-value="{{item.category}}" bindtap="browseCategory"><image src="/assets/{{item.image}}.jpg" mode="aspectFill"/><view><text class="eyebrow">0{{index+1}} / {{item.category}}</text><view class="scene-title">{{item.title}}</view><text>{{item.text}} →</text></view></view></view><view class="section-heading"><view><text class="eyebrow">PICKED WITH CARE</text><view class="heading">{{homeContent.featuredTitle}}</view></view><text data-value="全部" bindtap="browseCategory">全部好物 →</text></view><view class="muted">{{homeContent.featuredIntro}}</view><view class="grid home-products"><view class="card" wx:for="{{featured}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view wx:if="{{item.pickNote}}" class="pick-note">{{item.pickNote}}</view><view class="row"><view class="price">¥{{item.priceText}}</view><view class="add-small">＋</view></view></view></view></view><view wx:if="{{!featured.length}}" class="panel muted">店主正在挑选下一份好物，先去百货逛逛吧。</view><view class="new-shelf"><view class="section-heading"><view><text class="eyebrow">FRESH ON THE SHELF</text><view class="heading">{{homeContent.newTitle}}</view></view></view><scroll-view scroll-x class="new-rail"><view class="rail-inner"><view class="card" wx:for="{{latest}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view wx:if="{{item.pickNote}}" class="pick-note">{{item.pickNote}}</view><view class="row"><view class="price">¥{{item.priceText}}</view><view class="add-small">＋</view></view></view></view></view></scroll-view></view><view class="shopping-note"><text class="eyebrow">BEFORE YOU PICK</text><view class="heading">喜欢，也要合适</view><view>先看适用宠物与规格，再选尺寸和材质。给它挑一件真正用得上的好物。</view><button data-value="全部" bindtap="browseCategory">按分类慢慢挑 →</button></view></block>
  <view wx:else><view class="heading">宠物百货</view><input placeholder="搜索商品名称" value="{{search}}" bindinput="searchProducts"/></view>
  <view wx:if="{{tab === 'category'}}" class="pet-tabs"><button wx:for="{{petOptions}}" wx:key="*this" class="{{pet === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="goPet">{{item}}</button></view><view wx:if="{{tab === 'category'}}" class="catalog-layout"><scroll-view wx:if="{{tab === 'category'}}" scroll-y class="categories sidebar"><button wx:for="{{categories}}" wx:key="*this" class="{{category === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="category">{{item}}</button></scroll-view>
  <view class="grid {{tab === 'category' ? 'product-list' : ''}}"><view class="card" wx:for="{{tab === 'catalog' ? products : visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view class="row"><view class="price"><text>¥</text>{{item.priceText}}</view><view class="add-small">＋</view></view></view></view><view wx:if="{{tab === 'category' && !visible.length}}" class="empty">好物正在准备中<view>试试其他分类吧</view></view></view></view>
 </block>
 <block wx:if="{{tab === 'cart'}}"><view class="heading">我的购物车</view><view wx:if="{{!cart.length}}" class="empty"><image src="{{storefront.empty}}" mode="aspectFit"/><view class="empty-title">购物车还空着呢</view><view>把毛孩子的心愿，装进购物车吧</view><button data-tab="catalog" bindtap="tab">去逛逛</button></view><view class="panel cart-item" wx:for="{{cart}}" wx:key="skuId"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="cart-copy"><view>{{item.name}}</view><text class="muted">{{item.spec}} · ¥{{item.priceText}}</text><view class="row"><button size="mini" data-i="{{index}}" data-delta="-1" bindtap="qty">−</button><text>{{item.qty}}</text><button size="mini" data-i="{{index}}" data-delta="1" bindtap="qty">＋</button></view></view></view><view wx:if="{{cart.length}}" class="panel fulfillment-choice"><text class="eyebrow">HOW TO GET YOUR GOODIES</text><view class="section-title">这次，怎么带回家？</view><view class="mode-tabs"><button class="{{deliveryMode === 'DELIVERY' ? 'selected' : ''}}" data-value="DELIVERY" bindtap="deliveryMode">商家外送<text>由小店安排送达</text></button><button class="{{deliveryMode === 'PICKUP' ? 'selected' : ''}}" data-value="PICKUP" bindtap="deliveryMode">到店自提<text>顺路来店里坐坐</text></button></view><view wx:if="{{deliveryMode === 'PICKUP'}}"><view class="store-ticket"><text class="eyebrow">PICK UP HERE</text><view class="section-title">{{pickupStore.name}}</view><view>{{pickupStore.detail}}</view><text>{{pickupStore.hours}} · 自提免配送费</text></view><view class="field-label">提货人</view><input placeholder="提货人称呼" value="{{pickupContact.name}}" data-key="name" bindinput="pickupField"/><view class="field-label">联系电话</view><input placeholder="11 位手机号" type="number" maxlength="11" value="{{pickupContact.phone}}" data-key="phone" bindinput="pickupField"/></view><view wx:else><view class="row"><view class="section-title">送到这里</view><button class="text-link" data-tab="addresses" bindtap="tab">地址簿 →</button></view><picker range="{{addresses}}" range-key="detail" bindchange="pickAddress"><view class="address-select">{{addresses[addressIndex || 0].detail || '先去地址簿添加收货地点'}}<text>选择收货地址 ›</text></view></picker><text class="muted">由商家安排外送，订单中可查看配送单号或备注。</text></view><view class="checkout-summary"><view class="row"><text>商品小计</text><text>¥{{cartTotal}}</text></view><view class="row"><text>{{deliveryMode === 'PICKUP' ? '到店自提' : '商家外送费'}}</text><text>{{deliveryMode === 'PICKUP' ? '免费' : '¥8.00'}}</text></view><text class="muted">金额以服务端下单结果为准</text></view><button class="primary" disabled="{{busy}}" bindtap="checkout">提交{{deliveryMode === 'PICKUP' ? '自提' : '外送'}}订单 →</button></view></block>
<block wx:if="{{tab === 'account'}}"><view class="member-card"><view class="member-top"><text>PAW FRIENDS CLUB</text><text class="member-pill">日常有你，真好</text></view><view class="member-person"><image src="{{storefront.avatar}}" mode="aspectFill"/><view><view class="member-name">你好，宠物家长</view><text>每一份小心意，都为它准备。</text></view></view><view class="member-footer"><text>爪爪小铺 · 我的日常</text><text>WITH LOVE ♡</text></view></view><view class="panel account-orders"><view class="row"><view class="section-title">我的订单</view><button class="text-link" data-tab="orders" bindtap="tab">全部订单 →</button></view><view class="order-quick"><button data-status="PENDING" bindtap="orderFilter"><view class="quick-icon">◷</view>待付款</button><button data-status="PAID" bindtap="orderFilter"><view class="quick-icon"><image src="/assets/nav-category.png"/></view>待备货</button><button data-status="SHIPPED" bindtap="orderFilter"><view class="quick-icon"><image src="/assets/nav-cart.png"/></view>配送中</button><button data-status="AFTERSALE" bindtap="orderFilter"><view class="quick-icon">♡</view>售后</button></view></view><view class="service-pair"><button data-value="PICKUP" bindtap="fulfillmentOrders"><image src="/assets/nav-home.png"/><view>我的自提</view><text>备货进度 · 到店提货码</text><text class="service-arrow">↗</text></button><button data-value="DELIVERY" bindtap="fulfillmentOrders"><image src="/assets/nav-cart.png"/><view>我的外送</view><text>商家配送 · 单号与进度</text><text class="service-arrow">↗</text></button></view><view class="panel service-menu"><button data-tab="addresses" bindtap="tab"><view class="menu-icon">⌖</view><view><view>我的地址簿</view><text>把好物送到熟悉的地方</text></view><text class="menu-arrow">›</text></button><button data-tab="merchant" bindtap="tab"><image src="/assets/nav-home.png"/><view><view>商家工作台</view><text>备货、外送与自提核销</text></view><text class="menu-arrow">›</text></button></view><view class="quiet-note">一间小店，认真照顾每个小日常。<view>演示账号 · 无真实付款</view></view></block>
<block wx:if="{{tab === 'addresses'}}"><view class="page-intro"><button class="text-link" data-tab="account" bindtap="tab">← 个人中心</button><text class="eyebrow">YOUR LITTLE PLACES</text><view class="heading">我的地址簿 <text>{{addresses.length}}</text></view><text>家的方向，和每一份期待。</text></view><view class="address-card" wx:for="{{addresses}}" wx:key="id"><view class="row"><view class="address-pin">⌖</view><text class="tag">外送收货地点</text></view><view class="address-detail">{{item.detail}}</view><view class="address-person">{{item.name}}<text>{{item.phone}}</text></view><view class="address-bottom"><button data-i="{{index}}" bindtap="editAddress">编辑地址</button><button class="text-link" data-id="{{item.id}}" bindtap="deleteAddress">删除</button></view></view><view wx:if="{{!addresses.length}}" class="address-empty"><view>⌖</view><view class="section-title">先记下一个熟悉的地方</view><text>添加地址，下次外送就不用再填写了。</text></view><button class="primary new-address" bindtap="newAddress">＋ 添加收货地址</button><view class="quiet-note">仅外送需要地址，到店自提无需填写。<view>模拟环境请使用虚构信息</view></view></block>
<view wx:if="{{addressEditing}}" class="overlay"><scroll-view scroll-y class="sheet address-editor"><button class="close" bindtap="closeAddress">×</button><text class="eyebrow">ADDRESS BOOK</text><view class="heading">{{addressForm.id ? '编辑地址' : '添加一个收货地点'}}</view><text class="muted">让毛孩子的好物，准确送到你身边。</text><view class="field-label">收货人</view><input placeholder="怎么称呼你" maxlength="40" value="{{addressForm.name}}" data-key="name" bindinput="field"/><view class="field-label">联系电话</view><input placeholder="11 位手机号码" type="number" maxlength="11" value="{{addressForm.phone}}" data-key="phone" bindinput="field"/><view class="field-label">详细地址</view><textarea placeholder="省、市、区、街道及门牌号" maxlength="200" value="{{addressForm.detail}}" data-key="detail" bindinput="field"/><view class="quiet-note">当前为模拟环境，请填写虚构资料。</view><button class="primary" bindtap="saveAddress" disabled="{{busy}}">保存这个地址</button></scroll-view></view>
 <block wx:if="{{tab === 'orders'}}"><view class="heading">我的订单</view><view class="mode-tabs order-modes"><button wx:for="{{fulfillmentOptions}}" wx:key="id" class="{{fulfillmentFilter === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="fulfillmentFilter">{{item.name}}</button></view><view class="panel"><input placeholder="订单号或商品名称" maxlength="80" value="{{orderQuery}}" bindinput="orderQueryField"/><picker range="{{orderStatusOptions}}" range-key="name" value="{{orderStatusIndex}}" bindchange="orderStatusField"><view>状态：{{orderStatusOptions[orderStatusIndex].name}} ▾</view></picker><button bindtap="searchOrders" disabled="{{busy}}">查询订单</button><view>共 {{orderTotal}} 单 · 第 {{orderPageNumber}} / {{orderPages}} 页</view><view class="row"><button size="mini" data-delta="-1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber <= 1}}">上一页</button><button size="mini" data-delta="1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber >= orderPages}}">下一页</button></view></view><view wx:if="{{!orders.length}}" class="empty">暂无订单</view><view class="panel" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="showOrder"><view class="row"><text>{{item.fulfillmentText}} · {{item.id}}</text><text class="tag">{{item.statusText}}</text></view><view>{{item.lines[0].name}}</view><view class="price">¥{{item.totalText}} →</view></view></block>
 <block wx:if="{{tab === 'merchant'}}"><view class="merchant-banner"><text class="eyebrow">PAW STORE STUDIO</text><view class="heading">商家工作台</view><text>把好物上架，把每一份喜欢送出去。</text></view><view wx:if="{{mode !== 'cloud'}}" class="panel">仅演示：切换模拟商家 <switch checked="{{merchant}}" bindchange="demoRole"/><text>云端身份由服务端商家表授权。</text></view><view wx:if="{{!merchant}}" class="empty">当前身份无商家权限</view><block wx:else><view class="row"><button class="primary" bindtap="newProduct">＋ 新增商品</button><button bindtap="openStore">店铺图片设置</button></view><button bindtap="openHome">首页内容设置</button><text class="muted">先保存为草稿，确认价格和库存后再上架。</text><view class="panel" wx:for="{{merchantProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="editProduct"><image class="admin-image" src="{{item.displayImage}}" mode="aspectFill"/><view>{{item.name}} · {{item.active ? '上架中' : '已下架'}}</view><text>¥{{item.priceText}} 起 · 编辑价格、库存及规格 →</text><button size="mini" data-id="{{item.id}}" catchtap="duplicateProduct">复制为新商品</button></view><view class="heading">订单管理</view><view class="mode-tabs order-modes"><button wx:for="{{fulfillmentOptions}}" wx:key="id" class="{{fulfillmentFilter === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="fulfillmentFilter">{{item.name}}</button></view><view class="panel"><input placeholder="订单号或商品名称" maxlength="80" value="{{orderQuery}}" bindinput="orderQueryField"/><picker range="{{orderStatusOptions}}" range-key="name" value="{{orderStatusIndex}}" bindchange="orderStatusField"><view>状态：{{orderStatusOptions[orderStatusIndex].name}} ▾</view></picker><button bindtap="searchOrders" disabled="{{busy}}">查询订单</button><view>共 {{orderTotal}} 单 · 第 {{orderPageNumber}} / {{orderPages}} 页</view><view class="row"><button size="mini" data-delta="-1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber <= 1}}">上一页</button><button size="mini" data-delta="1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber >= orderPages}}">下一页</button></view></view><view class="panel" wx:for="{{merchantOrders}}" wx:key="id" data-id="{{item.id}}" bindtap="showOrder">{{item.fulfillmentText}} · {{item.id}} · {{item.statusText}} · ¥{{item.totalText}}</view></block></block>
 <view wx:if="{{detail}}" class="overlay"><scroll-view scroll-y class="sheet"><button class="close" bindtap="close">×</button><swiper class="detail-gallery" indicator-dots="{{detail.gallery.length > 1}}"><swiper-item wx:for="{{detail.gallery}}" wx:key="*this"><image class="detail-art" src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="detail-intro"><view class="tag">样例商品 · 单店精选</view><view class="heading">{{detail.displayName}}</view><text class="description">{{detail.description}}</text></view><picker range="{{detail.skus}}" range-key="name" value="{{skuIndex}}" bindchange="spec"><view class="panel">规格：{{detail.skus[skuIndex].name}} ▾</view></picker><view class="price">¥{{detail.skus[skuIndex].priceText}}</view><text>可售库存 {{detail.skus[skuIndex].stock}}</text><view class="row"><text>数量</text><button size="mini" data-delta="-1" bindtap="detailQty">−</button><text>{{detailQty}}</text><button size="mini" data-delta="1" bindtap="detailQty">＋</button></view><view class="detail-actions"><button class="black" disabled="{{!detail.skus[skuIndex].stock}}" bindtap="add">加入购物车</button><button class="primary" disabled="{{!detail.skus[skuIndex].stock}}" bindtap="buy">立即购买</button></view></scroll-view></view>
 <view wx:if="{{selectedOrder}}" class="overlay"><scroll-view scroll-y class="sheet"><button bindtap="close">关闭详情</button><view class="heading">{{selectedOrder.statusText}}</view><text>订单 {{selectedOrder.id}}</text><view class="panel" wx:for="{{selectedOrder.lines}}" wx:key="skuId">{{item.name}} / {{item.spec}} × {{item.qty}}</view><view class="fulfillment-card"><view class="fulfillment-top"><image src="{{selectedOrder.isPickup ? '/assets/nav-home.png' : '/assets/nav-cart.png'}}"/><view><text class="eyebrow">{{selectedOrder.isPickup ? 'PICK UP IN STORE' : 'DELIVERED BY OUR SHOP'}}</text><view class="section-title">{{selectedOrder.fulfillmentText}}</view></view></view><view class="fulfillment-body"><view class="section-title">{{selectedOrder.isPickup ? selectedOrder.fulfillment.store.name : selectedOrder.address.detail}}</view><view wx:if="{{selectedOrder.isPickup}}" class="muted">{{selectedOrder.fulfillment.store.detail}}<view>{{selectedOrder.fulfillment.store.hours}}</view></view><view class="muted">{{selectedOrder.address.name}} · {{selectedOrder.address.phone}}</view><view wx:if="{{selectedOrder.isPickup && selectedOrder.status === 'PAID' && !merchant}}" class="pickup-pass"><text>{{selectedOrder.fulfillment.readyAt ? '已备好，可以来取啦' : '正在备货，请稍候到店'}}</text><view>{{selectedOrder.fulfillment.code}}</view><text>到店后向商家出示提货码</text></view><view wx:if="{{!selectedOrder.isPickup && selectedOrder.shipping}}" class="delivery-slip"><text>商家配送单号</text><view>{{selectedOrder.shipping.number || '未填写单号'}}</view><text>{{selectedOrder.shipping.note}}</text></view><view class="fulfillment-progress">下单 → 备货 → {{selectedOrder.isPickup ? '到店自提' : '商家送达'}} → 完成</view></view></view><view class="row"><text>订单合计</text><view class="price">¥{{selectedOrder.totalText}}</view></view><text>{{selectedOrder.isPickup ? '自提免配送费' : '含商家外送费 ¥' + selectedOrder.shippingText}}</text><view wx:if="{{selectedOrder.status === 'PENDING'}}"><text>15 分钟未付款自动超时释放库存</text><button class="primary" data-action="{{mode !== 'cloud' ? 'mockPay' : 'payment'}}" bindtap="action">{{mode !== 'cloud' ? '模拟付款（不扣款）' : '发起支付（尚未配置）'}}</button><button data-action="cancel" bindtap="action">取消订单</button></view><button wx:if="{{selectedOrder.status === 'SHIPPED'}}" data-action="confirmReceipt" bindtap="action">确认收货</button><button bindtap="tracking">查看履约记录</button><view wx:if="{{tracking}}" class="panel"><view>{{tracking.company}} {{tracking.number}}</view><view>{{tracking.note}}</view><text>{{tracking.notice}}</text><view wx:for="{{tracking.events}}" wx:key="time">{{item.text}}</view></view><view wx:if="{{merchant && selectedOrder.status === 'PAID'}}" class="panel"><view wx:if="{{selectedOrder.isPickup}}"><view class="section-title">{{selectedOrder.fulfillment.readyAt ? '到店核销' : '准备自提商品'}}</view><view wx:if="{{selectedOrder.fulfillment.readyAt}}"><view class="field-label">买家出示的提货码</view><input placeholder="输入 6 位提货码" type="number" maxlength="6" value="{{redeemCode}}" bindinput="redeemField"/><button class="primary" disabled="{{busy}}" data-action="pickupRedeem" bindtap="action">核销并完成自提</button></view><view wx:else><text class="muted">核对商品后标记备好，买家订单将显示可到店领取。</text><button class="primary" disabled="{{busy}}" data-action="pickupReady" bindtap="action">商品已备好，可到店自提</button></view></view><view wx:else><text class="eyebrow">SHOP DELIVERY</text><view class="section-title">安排商家外送</view><text class="muted">自行安排送货，登记单号或备注即可。</text><view class="field-label">配送单号</view><input placeholder="如 SD20261024（选填）" maxlength="40" value="{{shipment.number}}" data-key="number" bindinput="shipment"/><view class="field-label">配送备注</view><textarea placeholder="如店员配送，约下午送达（与单号至少填一项）" maxlength="200" value="{{shipment.note}}" data-key="note" bindinput="shipment"/><button class="primary" disabled="{{busy}}" bindtap="ship">确认已送出</button></view></view><view class="panel" wx:if="{{!merchant && (selectedOrder.status === 'PAID' || selectedOrder.status === 'SHIPPED' || selectedOrder.status === 'COMPLETED')}}"><view class="heading">申请售后</view><text>整单退款含原运费，不涉及真实资金。</text><picker wx:if="{{selectedOrder.status !== 'PAID'}}" range="{{afterTypes}}" bindchange="afterType"><view>售后类型：{{afterForm.type === 'REFUND_ONLY' ? '仅退款' : '退货退款'}}（点击选择）</view></picker><textarea placeholder="请填写售后原因" maxlength="300" value="{{afterForm.reason}}" data-key="reason" bindinput="afterField"/><button disabled="{{busy}}" data-action="refundRequest" bindtap="action">提交售后申请</button></view>
<view wx:if="{{selectedOrder.refund}}" class="panel"><view class="heading">{{selectedOrder.refund.stageText}}</view><view>售后单 {{selectedOrder.refund.caseId}}</view><view>{{selectedOrder.refund.type === 'RETURN_REFUND' ? '退货退款' : '仅退款'}} · ¥{{selectedOrder.refund.amountText}}</view><view>申请原因：{{selectedOrder.refund.reason}}</view><view wx:if="{{selectedOrder.refund.review}}">审核意见：{{selectedOrder.refund.review.note}}</view><view wx:if="{{selectedOrder.refund.returnAddress}}">退货至：{{selectedOrder.refund.returnAddress.name}} {{selectedOrder.refund.returnAddress.phone}} {{selectedOrder.refund.returnAddress.detail}}</view><view wx:if="{{selectedOrder.refund.returnShipping}}">退货物流：{{selectedOrder.refund.returnShipping.company}} {{selectedOrder.refund.returnShipping.number}}</view>
<button wx:if="{{!merchant && selectedOrder.refund.stage === 'REQUESTED'}}" disabled="{{busy}}" data-action="refundWithdraw" bindtap="action">撤回申请</button>
<view wx:if="{{merchant && selectedOrder.refund.stage === 'REQUESTED'}}"><textarea placeholder="填写审核意见" maxlength="300" data-key="note" bindinput="afterField"/><view wx:if="{{selectedOrder.refund.type === 'RETURN_REFUND'}}"><input placeholder="退货收件人" value="{{afterForm.returnName}}" data-key="returnName" bindinput="afterField"/><input placeholder="退货联系电话" value="{{afterForm.returnPhone}}" data-key="returnPhone" bindinput="afterField"/><input placeholder="退货地址" value="{{afterForm.returnAddress}}" data-key="returnAddress" bindinput="afterField"/></view><view wx:if="{{selectedOrder.refund.type === 'REFUND_ONLY' && selectedOrder.refund.previous !== 'PAID'}}"><switch checked="{{afterForm.waiveReturn}}" data-key="waiveReturn" bindchange="afterField"/>确认免退货退款，不增加库存</view><button disabled="{{busy}}" data-action="refundReview" data-approve="{{true}}" bindtap="action">同意售后</button><button disabled="{{busy}}" data-action="refundReview" data-approve="{{false}}" bindtap="action">拒绝申请</button></view>
<view wx:if="{{!merchant && selectedOrder.refund.stage === 'WAIT_RETURN'}}"><text>模拟运单，提交后锁定，请核对。</text><input placeholder="退货快递公司" data-key="company" bindinput="afterField"/><input placeholder="退货单号" data-key="number" bindinput="afterField"/><button disabled="{{busy}}" data-action="returnShip" bindtap="action">提交退货物流</button></view>
<view wx:if="{{merchant && selectedOrder.refund.stage === 'RETURN_TRANSIT'}}"><view class="heading">退货验收</view><view wx:for="{{receiptItems}}" wx:key="skuId" class="panel"><view>{{item.name}} / {{item.spec}} · 购买 {{item.qty}} 件</view><text>实收数量</text><input type="number" value="{{item.receivedQty}}" data-i="{{index}}" data-key="receivedQty" bindinput="receiptField"/><text>可售入库数量</text><input type="number" value="{{item.restockQty}}" data-i="{{index}}" data-key="restockQty" bindinput="receiptField"/></view><textarea placeholder="验收说明（含破损、缺件情况）" maxlength="300" data-key="receiptNote" bindinput="afterField"/><view><switch checked="{{afterForm.receiptConfirmed}}" data-key="receiptConfirmed" bindchange="afterField"/>确认验收数量，仍按整单 ¥{{selectedOrder.refund.amountText}} 退款</view><button disabled="{{busy}}" data-action="returnInspect" bindtap="action">确认验收并入库</button></view>
<view wx:if="{{selectedOrder.refund.inspection}}"><view wx:for="{{selectedOrder.refund.inspection.items}}" wx:key="skuId">{{item.name}} / {{item.spec}}：实收 {{item.receivedQty}} · 可售 {{item.restockQty}} · 隔离 {{item.quarantineQty}} · 缺件 {{item.missingQty}}</view><view>验收说明：{{selectedOrder.refund.inspection.note}}</view></view>
<view wx:if="{{selectedOrder.refund.failureReason}}">上次退款失败：{{selectedOrder.refund.failureReason}}</view><view wx:if="{{merchant && mode !== 'cloud' && (selectedOrder.refund.stage === 'WAIT_REFUND' || selectedOrder.refund.stage === 'REFUND_FAILED')}}"><button disabled="{{busy}}" data-action="mockRefund" bindtap="action">模拟退款成功（不涉及资金）</button><input placeholder="模拟退款失败原因" data-key="failReason" bindinput="afterField"/><button disabled="{{busy}}" data-action="refundFail" bindtap="action">模拟退款失败</button></view>
<view wx:for="{{selectedOrder.refund.timeline}}" wx:key="index" class="panel"><view>{{item.timeText}} · {{item.actor}} · {{item.label}}</view><text>{{item.detail}}</text></view></view><view wx:for="{{selectedOrder.refundHistory}}" wx:key="caseId" class="panel">历史售后 {{item.caseId}} · {{item.reason}} · {{item.review.note}}</view></scroll-view></view>
 <view wx:if="{{editor}}" class="overlay"><scroll-view scroll-y class="sheet"><button bindtap="close">关闭编辑</button><view class="heading">{{editor.id ? '编辑商品' : '新增好物'}}</view><view wx:if="{{!editor.id}}" class="template-grid"><button wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseTemplate">{{item.name}}<text>{{item.hint}}</text></button></view><text class="muted">1 填写信息 → 2 选择图片 → 3 设置规格和售价</text><view>商品名称</view><input maxlength="80" value="{{editor.name}}" data-key="name" bindinput="productField" placeholder="商品名称"/><picker range="{{productCategories}}" bindchange="productCategory"><view class="panel">分类：{{editor.category}} ▾</view></picker><picker range="{{productPets}}" bindchange="productPet"><view class="panel">适用宠物：{{editor.petScope}} ▾</view></picker><view>加入店主精选 <switch checked="{{editor.featured}}" bindchange="featured"/></view><input maxlength="80" value="{{editor.pickNote}}" data-key="pickNote" bindinput="productField" placeholder="店主推荐语（选填）"/><view>商品说明 · 按提示补充，买家可见</view><textarea maxlength="2000" value="{{editor.description}}" data-key="description" bindinput="productField"/><button data-target="product" bindtap="chooseImage">选择商品图片 · 自传 / 备选图库</button><text class="muted">备选图为 AI 示意。销售时请换成与实物一致的照片。</text><image wx:if="{{editor.image}}" src="{{editor.image}}" mode="aspectFit"/><view class="muted">最多 6 张，第一张为封面；添加新图会保留已有图片。</view><view class="asset-grid"><view wx:for="{{editor.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/><button size="mini" data-i="{{index}}" bindtap="coverPhoto">{{index === 0 ? '当前封面' : '设为封面'}}</button><button size="mini" data-i="{{index}}" bindtap="removePhoto">移除</button></view></view><view>上架 <switch checked="{{editor.active}}" bindchange="active"/></view><view class="panel" wx:for="{{editor.skus}}" wx:key="id"><text>规格 {{index + 1}}</text><input maxlength="80" value="{{item.name}}" data-i="{{index}}" data-key="name" bindinput="skuField"/><text>售价（元）</text><input type="digit" value="{{item.priceYuan}}" data-i="{{index}}" data-key="priceYuan" bindinput="skuField"/><text>可售库存（不含已预留）</text><input type="number" value="{{item.stock}}" data-i="{{index}}" data-key="stock" bindinput="skuField"/></view><button bindtap="addSku">增加规格</button><button class="primary" bindtap="saveProduct" disabled="{{busy}}">{{editor.active ? '保存并上架' : '保存草稿'}}</button></scroll-view></view>

<view wx:if="{{homeEditor}}" class="overlay"><scroll-view scroll-y class="sheet"><button bindtap="closeHome">取消</button><view class="heading">首页内容设置</view><view wx:for="{{homeFields}}" wx:key="key"><view>{{item.label}}</view><textarea maxlength="{{item.max}}" value="{{homeEditor[item.key]}}" data-key="{{item.key}}" bindinput="homeField"/></view><view class="panel" wx:for="{{homeEditor.scenes}}" wx:key="key"><view>生活场景 {{index+1}}</view><input maxlength="18" value="{{item.title}}" data-i="{{index}}" data-key="title" bindinput="sceneField"/><input maxlength="40" value="{{item.text}}" data-i="{{index}}" data-key="text" bindinput="sceneField"/><picker range="{{productCategories}}" data-i="{{index}}" data-key="category" bindchange="sceneField"><view>跳转分类：{{item.category}} ▾</view></picker><image src="/assets/{{item.image}}.jpg" mode="aspectFit"/><picker range="{{assets}}" range-key="name" data-i="{{index}}" data-key="image" bindchange="sceneField"><view>从备选图库更换配图 ▾</view></picker></view><button class="primary" bindtap="saveHome" disabled="{{busy}}">保存首页内容</button></scroll-view></view>
 <view wx:if="{{storeEditor}}" class="overlay"><scroll-view scroll-y class="sheet"><button bindtap="closeStore">取消</button><view class="heading">店铺图片设置</view><text class="muted">替换图片会保留现有配色与布局。保存后买家可见。</text><view class="panel" wx:for="{{storeSlots}}" wx:key="key"><view>{{item.name}}</view><text class="muted">{{item.hint}}</text><image src="{{storeEditor[item.key]}}" mode="aspectFit"/><button data-target="{{item.key}}" bindtap="chooseImage">更换图片</button></view><button class="primary" bindtap="saveStore" disabled="{{busy}}">保存店铺图片</button></scroll-view></view>
 <view wx:if="{{imageTarget}}" class="overlay image-picker"><scroll-view scroll-y class="sheet"><button bindtap="closeImages">返回编辑</button><view class="heading">选一张合适的图片</view><button class="primary" bindtap="uploadImage" disabled="{{busy}}">拍照 / 从相册选择（≤2MB）</button><text class="muted">建议 JPG / PNG。下面是免费备选的 AI 示意图，点击即可使用。</text><view class="asset-grid"><view wx:for="{{availableAssets}}" wx:key="id" data-src="{{item.src}}" bindtap="pickImage"><image src="{{item.src}}" mode="aspectFill"/><text>{{item.name}}</text><text class="muted">{{item.kind}} · AI 示意</text></view></view></scroll-view></view>
</view>
