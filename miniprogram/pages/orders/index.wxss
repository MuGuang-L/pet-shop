page{background:#faf8f3;color:#243b31}.order-center{padding:36rpx 28rpx 70rpx}.center-heading{font-size:44rpx;font-weight:700}.center-intro{margin:12rpx 0 30rpx;color:#758078;font-size:25rpx}.order-filters{white-space:nowrap;margin-bottom:24rpx}.filter-row{display:flex;gap:14rpx;padding-bottom:10rpx}.filter{flex:none;margin:0;padding:0 26rpx;background:#efeee6;color:#536158;border-radius:40rpx;font-size:25rpx;line-height:68rpx}.filter.active{background:#254e3b;color:#fff}.order-card{margin-bottom:24rpx;padding:28rpx;background:#fff;border:1rpx solid #e9e7df;border-radius:22rpx}.card-meta{display:flex;justify-content:space-between;gap:20rpx;padding-bottom:22rpx;border-bottom:1rpx solid #efeee8;font-size:24rpx}.order-id{color:#7a817a;overflow-wrap:anywhere}.order-status{flex:none;color:#315e45;font-weight:600}.order-line{display:flex;gap:22rpx;margin-top:24rpx}.line-image{width:126rpx;height:126rpx;flex:none;border-radius:16rpx;background:#f3f0e8}.line-copy{flex:1;min-width:0}.line-name{font-size:28rpx;font-weight:600}.line-spec{margin:8rpx 0;color:#82867e;font-size:24rpx}.line-price{font-size:25rpx}.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:26rpx;font-size:24rpx}.order-total{font-size:32rpx;font-weight:700}.card-bottom button{flex:none;margin:0;border:1rpx solid #c7d0c5;border-radius:30rpx;padding:0 24rpx;background:#fff;color:#315e45;font-size:24rpx;line-height:60rpx}.center-message{padding:50rpx 28rpx;text-align:center;background:#fff;border-radius:22rpx;color:#758078;line-height:1.8}.center-message button,.more-orders,.back-shop{margin:26rpx auto 0;max-width:400rpx;background:#edf0e7;color:#315e45;font-size:26rpx;border-radius:40rpx}.center-loading{padding:32rpx;text-align:center;color:#758078;font-size:25rpx}.back-shop{background:transparent}button::after{border:0}
