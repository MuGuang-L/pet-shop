page{background:#faf8f3;color:#292722}.order-center{padding:30rpx 28rpx 70rpx}.center-heading{font-size:38rpx;font-weight:700;margin-bottom:18rpx}.order-filters{white-space:nowrap;margin-bottom:26rpx}.filter-row{display:flex;gap:6rpx}.filter{flex:none;margin:0;padding:16rpx 20rpx;background:transparent;border-radius:0;min-height:72rpx;font-size:25rpx;color:#756c65;font-weight:400}.filter.active{color:#a9420e;border-bottom:4rpx solid #a9420e;font-weight:700}.center-message{padding:50rpx 28rpx;text-align:center;background:white;border-radius:22rpx;color:#82756a;line-height:1.8}.center-message button,.more-orders,.back-shop{margin:26rpx auto 0;max-width:400rpx;background:#f5ede6;color:#a9420e;font-size:26rpx;border-radius:40rpx}.center-loading{padding:32rpx;text-align:center;color:#82756a;font-size:25rpx}.back-shop{background:transparent}button::after{border:0}

page{background:#f5f5f5}.order-center{padding:0 24rpx 48rpx}.center-navigation{height:96rpx;display:flex;align-items:center;justify-content:space-between;margin:0 -24rpx;padding:0 24rpx;background:#fff}.center-heading{font-size:32rpx;margin:0}.center-tabs{margin:0 -24rpx;background:white;position:sticky;top:0;z-index:5}.center-search{display:flex;align-items:center;gap:16rpx;margin:24rpx 0}.center-search input{flex:1;min-width:0;margin:0;background:#fff;border:0;border-radius:40rpx;padding:16rpx 24rpx;min-height:72rpx}.center-scope{display:flex;align-items:center;justify-content:space-between;padding:0 8rpx 20rpx;font-size:26rpx;color:#777}.center-message{border-radius:16rpx}.purchase-card{border-radius:16rpx;margin-bottom:24rpx;background:#fff}.center-loading{display:flex;justify-content:center}.orders-back{background:transparent;font-size:26rpx;padding:12rpx;margin:0;min-height:72rpx}

/* Cozy order center */
page{background:#fff8eb;color:#624632}.center-navigation,.center-tabs{background:#fffaf1}.center-navigation{border-bottom:1rpx solid #ecdfca}.center-search input,.center-message,.purchase-card{background:#fffdf6;border:1rpx solid #ecdfca;border-radius:26rpx}.center-message{padding:30rpx 24rpx 44rpx}.orders-back,.center-scope{color:#8d6849}.center-search{gap:10rpx}.center-empty-art{display:block;width:300rpx;height:260rpx;margin:0 auto 18rpx;border-radius:26rpx}.empty-title{font-family:KigiTitle,sans-serif;font-size:33rpx;margin-bottom:24rpx}.purchase-card{padding:26rpx}.purchase-status,.purchase-amount{color:#a85a32}
