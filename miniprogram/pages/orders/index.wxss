page{background:#faf8f3;color:#292722}.order-center{padding:30rpx 28rpx 70rpx}.center-heading{font-size:38rpx;font-weight:700;margin-bottom:18rpx}.order-filters{white-space:nowrap;margin-bottom:26rpx}.filter-row{display:flex;gap:6rpx}.filter{flex:none;margin:0;padding:16rpx 20rpx;background:transparent;border-radius:0;min-height:72rpx;font-size:25rpx;color:#756c65;font-weight:400}.filter.active{color:#a9420e;border-bottom:4rpx solid #a9420e;font-weight:700}.center-message{padding:50rpx 28rpx;text-align:center;background:white;border-radius:22rpx;color:#82756a;line-height:1.8}.center-message button,.more-orders,.back-shop{margin:26rpx auto 0;max-width:400rpx;background:#f5ede6;color:#a9420e;font-size:26rpx;border-radius:40rpx}.center-loading{padding:32rpx;text-align:center;color:#82756a;font-size:25rpx}.back-shop{background:transparent}button::after{border:0}
