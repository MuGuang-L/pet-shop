.delivery-timeline-card{margin-top:32rpx;padding-top:28rpx;border-top:1rpx solid #eee}
.delivery-timeline-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:30rpx;font-weight:600}
.delivery-copy{margin:0;padding:8rpx 0 8rpx 16rpx;background:transparent;color:#777;font-size:23rpx;font-weight:400;line-height:1.5;min-height:0;border:0}.delivery-copy::after,.delivery-expand::after{border:0}
.delivery-order-number{margin:10rpx 0 30rpx;color:#888;font-size:23rpx;word-break:break-all}
.delivery-event{position:relative;padding:0 0 36rpx 36rpx;margin-left:10rpx;border-left:2rpx solid #e5e5e5}.delivery-event-last{border-left-color:transparent;padding-bottom:8rpx}
.delivery-event-dot{position:absolute;left:-10rpx;top:8rpx;box-sizing:border-box;width:18rpx;height:18rpx;border:3rpx solid #ccc;border-radius:50%;background:#fff}
.delivery-event-header{display:flex;flex-wrap:wrap;align-items:baseline;gap:8rpx 16rpx}.delivery-event-title{font-size:29rpx;font-weight:600;color:#555;line-height:1.5}.delivery-event-time{color:#999;font-size:22rpx;line-height:1.6}.delivery-event-detail{margin-top:10rpx;color:#888;font-size:25rpx;line-height:1.7;white-space:pre-wrap;word-break:break-all}
.delivery-event-current .delivery-event-dot{background:#c24e13;border-color:#c24e13;box-shadow:0 0 0 6rpx #fff2e9}.delivery-event-current .delivery-event-title,.delivery-event-current .delivery-event-time{color:#c24e13}.delivery-event-current .delivery-event-detail{color:#555}
.delivery-expand{margin:12rpx 0 0;padding:16rpx;background:transparent;color:#777;font-size:25rpx;font-weight:400;line-height:1.5}.delivery-source{margin-top:18rpx;color:#999;font-size:21rpx;line-height:1.6}

.express-card{background:#fff}.express-notice{font-size:24rpx;color:#888;line-height:1.6;margin:20rpx 0}.express-status{font-size:30rpx;color:#c24e13;margin-top:16rpx}.express-card .delivery-timeline{margin-top:28rpx}

.feedback-option{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;line-height:1.5;}

/* Main departments and pet filters have separate visual hierarchy. */
.shop-section-tabs{display:flex;gap:40rpx;margin:8rpx 0 24rpx;border-bottom:1rpx solid #e7e2dc}
.shop-section-tabs button{position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:none;height:88rpx;min-height:0;margin:0;padding:0 8rpx;border:0;border-radius:0;background:transparent;color:#888;font-size:34rpx;font-weight:500;line-height:1;text-align:center}
.shop-section-tabs button.chosen{color:#a9420e;font-weight:700}
.shop-section-tabs button::after{display:none}
.shop-section-tabs button.chosen::after{display:block;position:absolute;left:50%;right:auto;top:auto;bottom:0;width:40rpx;height:6rpx;margin-left:-20rpx;border:0;border-radius:6rpx;background:#a9420e;transform:none}
.pet-filter-tabs{display:flex;align-items:center;gap:16rpx;margin:4rpx 0 24rpx}
.pet-filter-tabs button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex:none;height:64rpx;min-height:0;min-width:108rpx;margin:0;padding:0 28rpx;border:0;border-radius:32rpx;background:#eeebe7;color:#69645e;font-size:26rpx;font-weight:400;line-height:1;text-align:center}
.pet-filter-tabs button.chosen{background:#fae9df;color:#a9420e;font-weight:600}
.pet-filter-tabs button::after{display:none}
.coffee-pickup-caption{margin:-8rpx 0 20rpx;color:#888;font-size:23rpx;line-height:1.5}
