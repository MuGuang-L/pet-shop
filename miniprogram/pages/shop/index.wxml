<template name="buyer-order-card">
 <view class="purchase-card" data-id="{{purchase.id}}" bindtap="showOrder">
  <view class="purchase-head"><text class="purchase-store">奇迹空间 <text class="purchase-mode">{{purchase.fulfillmentText}}</text></text><text class="purchase-status">{{purchase.statusText}}</text></view>
  <view class="muted">订单 {{purchase.orderNo || purchase.id}} · {{purchase.orderDateText}}</view><view class="purchase-line" wx:for="{{purchase.lines}}" wx:key="skuId">
   <image src="{{item.displayImage}}" mode="aspectFill"/>
   <view class="purchase-copy"><view class="purchase-name">{{item.name}}</view><text class="purchase-spec">{{item.spec}}</text></view>
   <view class="purchase-numbers"><text>¥{{item.unitText}}</text><text class="purchase-qty">×{{item.qty}}</text></view>
  </view>
  <view wx:if="{{purchase.issueInfo && purchase.issueInfo.status === 'OPEN'}}" class="buyer-issue-note">{{purchase.issueInfo.note}}</view>
  <view class="purchase-total"><text>共 {{purchase.itemCount}} 件</text><text>合计 <text class="purchase-amount">¥{{purchase.totalText}}</text></text></view>
  <view class="purchase-footer"><text wx:if="{{purchase.status === 'PENDING' && purchase.remainingText}}" class="purchase-clock">{{purchase.remainingText}}</text><button data-id="{{purchase.id}}" data-section="{{purchase.primaryAction.section}}" catchtap="showOrder" class="purchase-action {{purchase.status === 'PENDING' ? 'purchase-action-primary' : ''}}">{{purchase.primaryAction.label}}</button></view>
 </view>
</template>

<view class="shell">
 <view wx:if="{{mode !== 'cloud'}}" class="notice">{{mode === 'api' ? '店铺体验 · 不发生真实付款' : (mode === 'mock' ? '本地模式 · 不发生真实付款' : '微信支付')}}</view>
 <view wx:if="{{tab === 'catalog' || tab === 'category'}}" class="brand"><view class="brand-left"><view class="brand-logo-frame"><image class="brand-logo" src="/assets/kigi-logo.jpg" mode="aspectFit"/></view><view>奇迹空间<text>宠物百货 · 咖啡烘焙</text></view></view><text class="store-tag">单店自营</text></view>
 <view class="nav"><button class="{{tab === 'catalog' ? 'active' : ''}}" data-tab="catalog" bindtap="tab"><image src="/assets/nav-home.png"/>首页</button><button class="{{tab === 'category' ? 'active' : ''}}" data-tab="category" bindtap="tab"><image src="/assets/nav-category.png"/>宠物百货</button><button class="{{tab === 'cart' || tab === 'checkout' ? 'active' : ''}}" data-tab="cart" bindtap="tab"><image src="/assets/nav-cart.png"/>购物车 {{cartCount || ''}}</button><button class="{{tab !== 'catalog' && tab !== 'category' && tab !== 'cart' && tab !== 'checkout' ? 'active' : ''}}" data-tab="account" bindtap="tab"><image src="/assets/nav-account.png"/>个人中心</button></view>
 <view wx:if="{{busy}}" class="request-status">正在处理，请稍候…</view>
 <view wx:if="{{loadError && !loginRequired}}" class="buyer-error"><text>{{loadError}}</text><button size="mini" bindtap="retry" disabled="{{busy}}">重新加载</button></view>
 <block wx:if="{{tab === 'catalog' || tab === 'category'}}">
  <block wx:if="{{tab === 'catalog'}}"><view class="hero"><image class="hero-image" src="{{storefront.hero}}" mode="widthFix"/><view class="hero-copy"><text class="eyebrow">奇迹空间 · 宠物百货</text><view class="headline home-headline">{{homeContent.headline}}</view><text class="hero-subtitle">{{homeContent.subtitle}}</text><button class="hero-button" data-value="全部" bindtap="browseCategory">查看商品</button></view></view><view class="benefits"><text>门店自营</text><text wx:if="{{pickupEnabled}}">到店自提</text><text wx:if="{{deliveryEnabled}}">快递配送</text></view><view class="pet-gates"><view data-value="猫咪" bindtap="goPet"><view><view>猫咪用品</view><text>查看商品 ›</text></view><image src="{{storefront.cat}}" mode="aspectFill"/></view><view data-value="狗狗" bindtap="goPet"><view><view>狗狗用品</view><text>查看商品 ›</text></view><image src="{{storefront.dog}}" mode="aspectFill"/></view></view><view class="section-heading"><view><view class="heading">按分类选购</view></view></view><view class="scene-grid"><view wx:for="{{homeContent.scenes}}" wx:key="key" data-value="{{item.category}}" bindtap="browseCategory"><image src="/assets/{{item.image}}.jpg" mode="aspectFill"/><view><text class="eyebrow">0{{index+1}} / {{item.category}}</text><view class="scene-title">{{item.title}}</view><text>{{item.text}} →</text></view></view></view><view class="section-heading"><view><view class="heading">{{homeContent.featuredTitle}}</view></view><text data-value="全部" bindtap="browseCategory">全部商品 ›</text></view><view class="muted">{{homeContent.featuredIntro}}</view><view class="grid home-products"><view class="card" wx:for="{{featured}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view wx:if="{{item.pickNote}}" class="pick-note">{{item.pickNote}}</view><view class="row"><view class="price">¥{{item.priceText}}</view><view class="add-small">＋</view></view></view></view></view><view wx:if="{{!featured.length}}" class="panel muted">暂无推荐商品</view><view class="new-shelf"><view class="section-heading"><view><view class="heading">{{homeContent.newTitle}}</view></view></view><scroll-view scroll-x class="new-rail"><view class="rail-inner"><view class="card" wx:for="{{latest}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view wx:if="{{item.pickNote}}" class="pick-note">{{item.pickNote}}</view><view class="row"><view class="price">¥{{item.priceText}}</view><view class="add-small">＋</view></view></view></view></view></scroll-view></view></block>
  <view wx:else><view class="heading">宠物百货</view><input placeholder="搜索商品名称或描述" value="{{search}}" bindinput="searchProducts"/><view class="buyer-tools"><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortProducts"><view>{{sortOptions[sortIndex]}} ▾</view></picker><label><switch checked="{{stockOnly}}" bindchange="stockFilter" color="#a9420e"/>仅看有货</label></view></view>
  <view wx:if="{{tab === 'category'}}" class="pet-tabs"><button wx:for="{{petOptions}}" wx:key="*this" class="{{pet === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="goPet">{{item}}</button></view><view wx:if="{{tab === 'category'}}" class="catalog-layout"><scroll-view wx:if="{{tab === 'category'}}" scroll-y class="categories sidebar"><button wx:for="{{categories}}" wx:key="*this" class="{{category === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="category">{{item}}</button></scroll-view>
  <view class="grid {{tab === 'category' ? 'product-list' : ''}}"><view class="card" wx:for="{{tab === 'catalog' ? products : visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view class="row"><view class="price"><text>¥</text>{{item.priceText}}</view><view class="add-small">＋</view></view></view></view><view wx:if="{{tab === 'category' && !visible.length}}" class="empty">暂无商品<view>试试其他分类吧</view></view></view></view>
 </block>
 <block wx:if="{{tab === 'cart'}}">
  <view class="heading">我的购物车</view>
  <view wx:if="{{!cart.length}}" class="empty"><image src="{{storefront.empty}}" mode="aspectFit"/><view class="empty-title">购物车为空</view><button data-tab="catalog" bindtap="tab">去逛逛</button></view>
  <view wx:if="{{cart.length}}" class="row cart-select-bar"><button size="mini" bindtap="toggleAll">{{allSelected ? '☑ 全选' : '○ 全选'}}</button><text>已选 {{selectedCount}} 件</text></view>
  <view class="panel cart-item" wx:for="{{cart}}" wx:key="skuId"><button class="line-check" data-i="{{index}}" bindtap="toggleLine" aria-label="选择商品">{{item.selected ? '☑' : '○'}}</button><image src="{{item.displayImage}}" mode="aspectFill"/><view class="cart-copy"><view>{{item.name}}</view><text class="muted">{{item.spec}} · ¥{{item.priceText}}</text><view wx:if="{{item.invalid}}" class="buyer-invalid">{{item.invalid}}</view><button class="text-link" size="mini" data-i="{{index}}" bindtap="removeCart">移除商品</button><view class="row"><button size="mini" data-i="{{index}}" data-delta="-1" bindtap="qty">−</button><text>{{item.qty}}</text><button size="mini" data-i="{{index}}" data-delta="1" bindtap="qty">＋</button></view></view></view>
  <view wx:if="{{cart.length}}" class="panel"><view class="row"><text>所选商品小计</text><text class="price">¥{{cartTotal}}</text></view><text class="muted">下一步选择配送方式并核对运费。</text><button class="primary" disabled="{{busy || !selectedCount || cartInvalid}}" bindtap="prepareCheckout">去结算（{{selectedCount}} 件） →</button></view>
 </block>
 <block wx:if="{{tab === 'checkout'}}"><button class="text-link" bindtap="backCheckout">← {{checkoutSource === 'quick' ? '返回选购' : '返回购物车'}}</button><view class="heading">确认订单</view><view wx:if="{{shopNotice}}" class="buyer-error">{{shopNotice}}</view><text class="muted">{{checkoutSource === 'quick' ? '本次仅结算当前商品，购物车内容不变。' : '仅结算已勾选商品，其余商品留在购物车。'}}</text><view class="panel checkout-product" wx:for="{{checkoutLines}}" wx:key="skuId"><image src="{{item.displayImage}}" mode="aspectFill"/><view><view>{{item.name}}</view><text class="muted">{{item.spec}} × {{item.qty}}</text><view>¥{{item.lineTotalText}}</view><text wx:if="{{item.invalid}}" class="buyer-invalid">{{item.invalid}}</text></view></view>
<view class="panel fulfillment-choice"><view class="section-title">配送方式</view><view class="mode-tabs"><button class="{{deliveryMode === 'DELIVERY' ? 'selected' : ''}}" disabled="{{busy || !deliveryEnabled}}" data-value="DELIVERY" bindtap="deliveryMode">快递配送<text>快递配送</text></button><button class="{{deliveryMode === 'PICKUP' ? 'selected' : ''}}" disabled="{{busy || !pickupEnabled}}" data-value="PICKUP" bindtap="deliveryMode">到店自提<text>到店领取 · 免配送费</text></button></view><view wx:if="{{deliveryMode === 'PICKUP'}}"><view class="store-ticket"><view class="section-title">{{pickupStore.name}}</view><view>{{pickupStore.detail}}</view><text>{{pickupStore.hours}} · 自提免配送费</text><view wx:if="{{shopSettings.pickup.instructions}}" class="muted">{{shopSettings.pickup.instructions}}</view></view><view class="field-label">提货人</view><input placeholder="提货人称呼" value="{{pickupContact.name}}" data-key="name" bindinput="pickupField"/><view class="field-label">联系电话</view><input placeholder="11 位手机号" type="number" maxlength="11" value="{{pickupContact.phone}}" data-key="phone" bindinput="pickupField"/></view><view wx:else><view class="row"><view class="section-title">收货地址</view><button class="text-link" bindtap="openAddresses">选择 / 新增地址 →</button></view><view wx:if="{{selectedAddress}}" class="address-select" bindtap="openAddresses"><view class="checkout-person">{{selectedAddress.name}}<text>{{selectedAddress.phone}}</text></view><view>{{selectedAddress.detail}}</view><text>点击更换收货地址 ›</text></view><button wx:else class="address-add" bindtap="openAddresses">＋ 添加收货地址</button><text class="muted">{{shopSettings.delivery.area}} {{shopSettings.delivery.instructions}}</text></view><view class="checkout-summary"><view class="row"><text>商品小计</text><text>¥{{cartTotal}}</text></view><view class="row"><text>{{deliveryMode === 'PICKUP' ? '到店自提' : '快递配送费'}}</text><text>{{deliveryMode === 'PICKUP' ? '免费' : '¥' + shippingEstimate}}</text></view><view class="row buyer-total"><text>预计合计</text><text>¥{{checkoutTotal}}</text></view><text class="muted">费用按当前门店设置计算，提交前将再次核对。</text></view><button class="primary" disabled="{{busy || cartInvalid || !canOrder}}" bindtap="checkout">{{deliveryMode === 'DELIVERY' && !selectedAddress ? '添加地址后下单 →' : (deliveryMode === 'PICKUP' ? '提交自提订单 →' : '提交快递配送订单 →')}}</button></view></block>
<block wx:if="{{tab === 'account'}}"><view class="account-heading"><view class="heading">我的</view><text>奇迹空间宠物咖啡店</text></view><view class="panel account-orders"><view class="row"><view class="section-title">我的订单</view><button class="text-link" data-tab="orders" bindtap="tab">全部订单 →</button></view><view class="order-quick"><button data-status="PENDING" bindtap="orderFilter"><view class="quick-icon"><t-icon name="time" size="44rpx"/></view>待付款</button><button data-status="PAID" bindtap="orderFilter"><view class="quick-icon"><image src="/assets/nav-category.png"/></view>待备货</button><button data-status="SHIPPED" bindtap="orderFilter"><view class="quick-icon"><image src="/assets/nav-cart.png"/></view>配送中</button><button data-status="AFTERSALE" bindtap="orderFilter"><view class="quick-icon"><t-icon name="service" size="44rpx"/></view>售后</button></view></view><view class="service-pair"><button data-value="PICKUP" bindtap="fulfillmentOrders"><image src="/assets/nav-home.png"/><view>我的自提</view><text>备货进度 · 到店出示订单</text><text class="service-arrow">↗</text></button><button data-value="DELIVERY" bindtap="fulfillmentOrders"><image src="/assets/nav-cart.png"/><view>我的快递配送</view><text>快递配送 · 单号与进度</text><text class="service-arrow">↗</text></button></view><view class="account-service-list"><t-cell-group theme="card"><t-cell title="联系商家" left-icon="service" arrow bind:click="openSupport"/><t-cell title="购物反馈" left-icon="edit" arrow bind:click="openFeedback"/><t-cell title="收货地址" left-icon="location" arrow bind:click="openAddresses"/></t-cell-group></view><view class="quiet-note"><view wx:if="{{mode!=='cloud'}}">当前账号 · 无真实付款</view><button wx:if="{{mode!=='cloud'}}" class="text-link" bindtap="logout">退出账号</button></view></block>
<block wx:if="{{tab === 'addresses'}}"><view class="page-intro"><button class="text-link" bindtap="backAddresses">← {{addressReturn === 'checkout' ? '返回确认订单' : (addressReturn === 'cart' ? '返回购物车' : '个人中心')}}</button><text class="eyebrow">YOUR LITTLE PLACES</text><view class="heading">收货地址 <text>{{addresses.length}}</text></view><text>家的方向，和每一份期待。</text></view><view class="address-card" wx:for="{{addresses}}" wx:key="id"><view class="row"><view class="address-pin">⌖</view><text class="tag">快递配送收货地点</text></view><view class="address-detail">{{item.detail}}</view><view class="address-person">{{item.name}}<text>{{item.phone}}</text></view><view class="address-bottom"><button wx:if="{{addressReturn === 'cart' || addressReturn === 'checkout'}}" data-i="{{index}}" bindtap="useAddress">用这个地址</button><button data-i="{{index}}" bindtap="editAddress">编辑地址</button><button class="text-link" data-id="{{item.id}}" bindtap="deleteAddress">删除</button></view></view><view wx:if="{{!addresses.length}}" class="address-empty"><view>⌖</view><view class="section-title">先记下一个熟悉的地方</view><text>添加地址，下次快递配送就不用再填写了。</text></view><button class="primary new-address" bindtap="newAddress">＋ 添加收货地址</button><view class="quiet-note">仅快递配送需要地址，到店自提无需填写。<view>请填写准确的收货信息</view></view></block>
<view wx:if="{{addressEditing}}" class="overlay"><scroll-view scroll-y class="sheet address-editor"><button class="close" bindtap="closeAddress">×</button><text class="eyebrow">ADDRESS BOOK</text><view class="heading">{{addressForm.id ? '编辑地址' : '添加一个收货地点'}}</view><text class="muted">让毛孩子的好物，准确送到你身边。</text><view class="field-label">收货人</view><input placeholder="怎么称呼你" maxlength="40" value="{{addressForm.name}}" data-key="name" bindinput="field"/><view class="field-label">联系电话</view><input placeholder="11 位手机号码" type="number" maxlength="11" value="{{addressForm.phone}}" data-key="phone" bindinput="field"/><view class="field-label">详细地址</view><textarea placeholder="省、市、区、街道及门牌号" maxlength="200" value="{{addressForm.detail}}" data-key="detail" bindinput="field"/><view class="quiet-note">请核对收货信息，确保能够联系到您。</view><button class="primary" bindtap="saveAddress" disabled="{{busy}}">保存这个地址</button></scroll-view></view>
 <block wx:if="{{tab === 'orders'}}"><view class="orders-toolbar"><button class="orders-back" bindtap="backOrders">‹ 返回</button><view class="heading">我的订单</view><button class="text-link" bindtap="searchOrders" disabled="{{busy}}">刷新订单</button></view><scroll-view scroll-x class="order-quick-tabs"><view class="order-quick-inner"><button wx:for="{{orderQuickOptions}}" wx:key="id" class="{{orderStatus === item.id ? 'chosen' : ''}}" data-status="{{item.id}}" bindtap="orderFilter">{{item.name}}</button></view></scroll-view><view class="order-search-bar"><input placeholder="搜索商品或订单号" maxlength="80" value="{{orderQuery}}" bindinput="orderQueryField" bindconfirm="searchOrders" confirm-type="search"/><button bindtap="searchOrders" disabled="{{busy}}">搜索</button></view><view wx:if="{{fulfillmentFilter !== 'ALL'}}" class="order-scope"><text>{{fulfillmentFilter === 'PICKUP' ? '到店自提' : '快递配送'}}</text><button data-value="ALL" bindtap="fulfillmentFilter">查看全部</button></view><view wx:if="{{busy && !orders.length}}" class="empty">正在加载订单…</view><view wx:elif="{{!orders.length}}" class="empty"><view class="empty-title">暂无相关订单</view><text>换个状态看看，或去挑选商品</text><button data-tab="category" bindtap="tab">去逛逛</button></view><block wx:for="{{orders}}" wx:key="id" wx:for-item="purchase"><template is="buyer-order-card" data="{{purchase}}"/></block><view wx:if="{{orderPages > 1}}" class="order-pagination"><button size="mini" data-delta="-1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber <= 1}}">上一页</button><text>{{orderPageNumber}} / {{orderPages}}</text><button size="mini" data-delta="1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber >= orderPages}}">下一页</button></view></block>

 <view wx:if="{{detail}}" class="overlay"><scroll-view scroll-y class="sheet"><button class="close" bindtap="close">×</button><swiper class="detail-gallery" indicator-dots="{{detail.gallery.length > 1}}"><swiper-item wx:for="{{detail.gallery}}" wx:key="*this"><image class="detail-art" src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="detail-intro"><view class="tag">单店精选</view><view class="heading">{{detail.displayName}}</view><text class="description">{{detail.description}}</text></view><picker range="{{detail.skus}}" range-key="name" value="{{skuIndex}}" bindchange="spec"><view class="panel">规格：{{detail.skus[skuIndex].name}} ▾</view></picker><view class="price">¥{{detail.skus[skuIndex].priceText}}</view><text>可售库存 {{detail.skus[skuIndex].stock}}</text><view class="row"><text>数量</text><button size="mini" data-delta="-1" bindtap="detailQty">−</button><text>{{detailQty}}</text><button size="mini" data-delta="1" bindtap="detailQty">＋</button></view><view class="detail-actions"><button class="black" disabled="{{!detail.skus[skuIndex].stock}}" bindtap="add">加入购物车</button><button class="primary" disabled="{{!detail.skus[skuIndex].stock}}" bindtap="buy">立即购买</button></view></scroll-view></view>
 <view wx:if="{{selectedOrder}}" class="overlay order-overlay" bindtap="closeOrder"><view class="order-detail-shell" catchtap="keepOrderOpen"><view class="order-detail-bar"><button bindtap="closeOrder">‹ 返回</button><text>订单详情</text><button bindtap="refreshOrder" disabled="{{busy}}">刷新</button></view><scroll-view scroll-y scroll-into-view="{{orderScrollTarget}}" class="sheet order-detail-scroll"><view class="heading">{{selectedOrder.statusText}}</view><view class="order-next"><view>{{selectedOrder.nextStep}}</view></view><view wx:if="{{selectedOrder.issueInfo}}" class="buyer-issue"><view class="row"><view class="section-title">{{selectedOrder.issueInfo.title}}</view><text>{{selectedOrder.issueInfo.statusText}}</text></view><view>{{selectedOrder.issueInfo.note}}</view><view wx:if="{{selectedOrder.issueInfo.nextText && selectedOrder.issueInfo.status === 'OPEN'}}" class="issue-appointment">约定处理时间：{{selectedOrder.issueInfo.nextText}}</view><view class="issue-history" wx:for="{{selectedOrder.issueInfo.timeline}}" wx:key="key"><view>{{item.label}} · {{item.actor}}</view><text>{{item.timeText}}</text><view>{{item.detail}}</view><view wx:if="{{item.nextText}}">约定时间：{{item.nextText}}</view></view><button size="mini" bindtap="openSupport">联系商家</button></view><view wx:if="{{selectedOrder.status === 'PENDING'}}" class="order-deadline">{{selectedOrder.payExpired ? selectedOrder.remainingText : '剩余付款时间 ' + selectedOrder.remainingText}}<view>付款截止：{{selectedOrder.expiresText}}</view><view>超时未付款，订单将自动取消</view></view><view class="panel detail-products"><view class="purchase-line" wx:for="{{selectedOrder.lines}}" wx:key="skuId"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="purchase-copy"><view class="purchase-name">{{item.name}}</view><text class="purchase-spec">{{item.spec}}</text></view><view class="purchase-numbers"><text>¥{{item.unitText}}</text><text class="purchase-qty">×{{item.qty}}</text></view></view></view><view id="order-fulfillment" class="fulfillment-card"><view class="fulfillment-top"><image src="{{selectedOrder.isPickup ? '/assets/nav-home.png' : '/assets/nav-cart.png'}}"/><view><view class="section-title">{{selectedOrder.fulfillmentText}}</view></view></view><view class="fulfillment-body"><view class="section-title">{{selectedOrder.isPickup ? selectedOrder.fulfillment.store.name : selectedOrder.address.detail}}</view><view wx:if="{{selectedOrder.isPickup}}" class="muted">{{selectedOrder.fulfillment.store.detail}}<view>{{selectedOrder.fulfillment.store.hours}}</view></view><view class="muted">{{selectedOrder.address.name}} · {{selectedOrder.address.phone}}</view><view wx:if="{{selectedOrder.isPickup && selectedOrder.status === 'PAID' && !merchant}}" class="pickup-pass"><text>{{selectedOrder.issueInfo && selectedOrder.issueInfo.status === 'OPEN' ? '请按协商结果安排到店' : (selectedOrder.fulfillment.readyAt ? '已备好，请到店提货' : '备货中，请稍后查看订单')}}</text><view>订单 {{selectedOrder.orderNo || selectedOrder.id}}</view><text>到店后向商家出示本订单</text></view><view wx:if="{{!selectedOrder.isPickup && selectedOrder.shipping}}" class="delivery-slip"><text>{{selectedOrder.shipping.company}} · 快递单号</text><view>{{selectedOrder.shipping.number || '未填写单号'}}</view><button wx:if="{{selectedOrder.shipping.number}}" size="mini" bindtap="copyTracking">复制快递单号</button><text>{{selectedOrder.shipping.note}}</text></view><view class="delivery-timeline-card">
 <view class="delivery-timeline-heading"><text>{{selectedOrder.isPickup ? '自提进度' : '配送进度'}}</text><button class="delivery-copy" bindtap="copyOrderNumber">复制订单号</button></view>
 <view class="delivery-order-number">订单 {{selectedOrder.orderNo || selectedOrder.id}}</view>
 <view class="delivery-timeline">
  <block wx:for="{{selectedOrder.deliveryTimeline}}" wx:key="key">
   <view wx:if="{{deliveryExpanded || index < 3}}" class="delivery-event {{index === 0 ? 'delivery-event-current' : ''}} {{index === selectedOrder.deliveryTimeline.length - 1 || (!deliveryExpanded && index === 2) ? 'delivery-event-last' : ''}}">
    <view class="delivery-event-dot"></view><view class="delivery-event-body"><view class="delivery-event-header"><text class="delivery-event-title">{{item.title}}</text><text wx:if="{{item.timeText}}" class="delivery-event-time">{{item.timeText}}</text></view><view wx:if="{{item.detail}}" class="delivery-event-detail">{{item.detail}}</view></view>
   </view>
  </block>
 </view>
 <button wx:if="{{selectedOrder.deliveryTimeline.length > 3}}" class="delivery-expand" bindtap="toggleDeliveryTimeline">{{deliveryExpanded ? '收起历史记录 ↑' : '展开全部进度 ↓'}}</button>
 <view class="delivery-source">{{selectedOrder.isPickup ? '进度根据门店备货及提货确认记录更新' : '订单进度根据商家操作更新；点击下方查看快递物流'}}</view>
</view></view></view><view wx:if="{{!selectedOrder.isPickup}}" class="panel express-card">
 <view class="delivery-timeline-heading"><text>快递物流</text><button wx:if="{{tracking.provider === 'wechat'}}" class="delivery-copy" disabled="{{trackingLoading}}" bindtap="openOfficialTracking">{{trackingLoading ? '查询中…' : '查看物流'}}</button><button wx:else class="delivery-copy" disabled="{{trackingLoading}}" bindtap="tracking">{{trackingLoading ? '查询中…' : '刷新物流'}}</button></view>
 <view wx:if="{{tracking.statusText}}" class="express-status">{{tracking.statusText}}</view>
 <view wx:if="{{tracking.updatedText}}" class="delivery-order-number">更新于 {{tracking.updatedText}}</view>
 <view wx:if="{{trackingError}}" class="express-notice">{{trackingError}}</view>
 <view wx:if="{{tracking.notice}}" class="express-notice">{{tracking.notice}}</view>
 <view wx:if="{{!tracking && !trackingLoading && !trackingError}}" class="express-notice">{{selectedOrder.shipping ? '点击刷新物流，查看快递运输记录' : '商家发货后，可在此查看快递公司和运单轨迹'}}</view>
 <view class="delivery-timeline"><view wx:for="{{tracking.events}}" wx:key="key" class="delivery-event {{index === 0 ? 'delivery-event-current' : ''}} {{index === tracking.events.length - 1 ? 'delivery-event-last' : ''}}"><view class="delivery-event-dot"></view><view class="delivery-event-header"><text class="delivery-event-title">{{item.status}}</text><text class="delivery-event-time">{{item.timeText}}</text></view><view class="delivery-event-detail">{{item.text}}</view></view></view>
</view><view id="order-payment" class="order-money"><view class="row"><text>商品金额</text><text>¥{{selectedOrder.subtotalText}}</text></view><view class="row"><text>{{selectedOrder.isPickup ? '到店自提' : '快递配送费'}}</text><text>¥{{selectedOrder.shippingText}}</text></view><view class="row"><text>{{selectedOrder.amountLabel}}</text><view class="price">¥{{selectedOrder.totalText}}</view></view><text class="muted">{{selectedOrder.paymentNotice}}</text></view><view wx:if="{{selectedOrder.status === 'PENDING'}}"><button class="primary" disabled="{{busy || selectedOrder.payExpired}}" data-action="{{mode !== 'cloud' ? 'mockPay' : 'payment'}}" bindtap="action">{{mode !== 'cloud' ? '免扣款操作（不扣款）' : '微信支付'}}</button><button data-action="cancel" bindtap="action">取消订单</button></view><button wx:if="{{selectedOrder.status === 'SHIPPED'}}" data-action="confirmReceipt" bindtap="action">确认收货</button><button bindtap="openSupport">联系商家</button><view class="panel" wx:if="{{!merchant && (selectedOrder.status === 'PAID' || selectedOrder.status === 'SHIPPED' || selectedOrder.status === 'COMPLETED')}}"><button class="after-entry" bindtap="toggleAfterForm">申请售后 <text>{{afterFormOpen ? '收起 ↑' : '›'}}</text></button><view wx:if="{{afterFormOpen}}"><text>{{selectedOrder.refundNotice}}</text><picker wx:if="{{selectedOrder.status !== 'PAID'}}" range="{{afterTypes}}" value="{{afterForm.type === 'REFUND_ONLY' ? 1 : 0}}" bindchange="afterType"><view>售后类型：{{afterForm.type === 'REFUND_ONLY' ? '仅退款' : '退货退款'}}（点击选择）</view></picker><textarea placeholder="请填写售后原因" maxlength="300" value="{{afterForm.reason}}" data-key="reason" bindinput="afterField"/><button disabled="{{busy}}" data-action="refundRequest" bindtap="action">提交售后申请</button></view></view>
<view id="order-aftersale" wx:if="{{selectedOrder.refund}}" class="panel after-summary"><view class="section-title">退款 / 售后</view><view>{{selectedOrder.refund.type === 'RETURN_REFUND' ? '退货退款' : '仅退款'}} · ¥{{selectedOrder.refund.amountText}}</view><view>申请原因：{{selectedOrder.refund.reason}}</view><view wx:if="{{selectedOrder.refund.review}}">审核意见：{{selectedOrder.refund.review.note}}</view><view wx:if="{{selectedOrder.refund.returnAddress}}">退货至：{{selectedOrder.refund.returnAddress.name}} {{selectedOrder.refund.returnAddress.phone}} {{selectedOrder.refund.returnAddress.detail}}</view><view wx:if="{{selectedOrder.refund.returnShipping}}">退货物流：{{selectedOrder.refund.returnShipping.company}} {{selectedOrder.refund.returnShipping.number}}</view>
<button wx:if="{{!merchant && selectedOrder.refund.stage === 'REQUESTED'}}" disabled="{{busy}}" data-action="refundWithdraw" bindtap="action">撤回申请</button>

<view wx:if="{{!merchant && selectedOrder.refund.stage === 'WAIT_RETURN'}}"><text>运单提交后锁定，请核对。</text><input placeholder="退货快递公司" data-key="company" bindinput="afterField"/><input placeholder="退货单号" data-key="number" bindinput="afterField"/><button disabled="{{busy}}" data-action="returnShip" bindtap="action">提交退货物流</button></view>

<view wx:if="{{afterHistoryOpen && selectedOrder.refund.inspection}}"><view wx:for="{{selectedOrder.refund.inspection.items}}" wx:key="skuId">{{item.name}} / {{item.spec}}：实收 {{item.receivedQty}} · 可售 {{item.restockQty}} · 隔离 {{item.quarantineQty}} · 缺件 {{item.missingQty}}</view><view>验收说明：{{selectedOrder.refund.inspection.note}}</view></view>
<view wx:if="{{selectedOrder.refund.failureReason}}">上次退款失败：{{selectedOrder.refund.failureReason}}</view>
<button class="text-link" bindtap="toggleAfterHistory">{{afterHistoryOpen ? '收起处理记录 ↑' : '查看处理记录 ›'}}</button><view wx:if="{{afterHistoryOpen}}"><view wx:for="{{selectedOrder.refund.timeline}}" wx:key="index" class="panel"><view>{{item.timeText}} · {{item.actor}} · {{item.label}}</view><text>{{item.detail}}</text></view></view><view wx:for="{{selectedOrder.refundHistory}}" wx:key="caseId" class="panel">历史售后 {{item.caseId}} · {{item.reason}} · {{item.review.note}}</view></view><view class="panel order-record"><view class="section-title">订单信息</view><view class="row order-meta"><text>订单 {{selectedOrder.orderNo || selectedOrder.id}}</text><button size="mini" bindtap="copyOrderNumber">复制订单号</button></view><view class="order-meta">下单时间：{{selectedOrder.createdText}}</view></view></scroll-view></view></view>





<view wx:if="{{feedbackVisible}}" class="overlay support-overlay" bindtap="closeFeedback"><view class="support-shell" catchtap="keepOrderOpen"><view class="support-bar"><text>购物反馈</text><button bindtap="closeFeedback">关闭</button></view><scroll-view scroll-y class="sheet support-sheet">
<view wx:if="{{feedbackSubmitted}}"><view class="section-title">感谢反馈，已收到</view><text>本版问卷已提交，无需再次填写。</text><button bindtap="closeFeedback">完成</button></view>
<block wx:else><view wx:if="{{feedback}}"><view class="section-title">{{feedback.title}}</view><text>自愿填写，不影响购买和售后。</text><view wx:for="{{feedback.questions}}" wx:key="id" wx:for-item="question" wx:for-index="qi" class="panel"><view>{{qi + 1}}. {{question.title}}（{{question.type === 'single' ? '单选' : '多选'}} · {{question.required ? '必填' : '选填'}}）</view><radio-group wx:if="{{question.type === 'single'}}" data-i="{{qi}}" bindchange="feedbackChoice"><label wx:for="{{question.options}}" wx:key="index" class="feedback-option"><radio value="{{index}}" disabled="{{feedbackLoading}}"/>{{item}}</label></radio-group><checkbox-group wx:else data-i="{{qi}}" bindchange="feedbackChoice"><label wx:for="{{question.options}}" wx:key="index" class="feedback-option"><checkbox value="{{index}}" disabled="{{feedbackLoading}}"/>{{item}}</label></checkbox-group></view><button class="primary" bindtap="submitFeedback" disabled="{{feedbackLoading}}">{{feedbackLoading ? '正在提交…' : '提交反馈'}}</button></view><text wx:elif="{{feedbackLoading}}">正在读取问卷…</text><text wx:elif="{{!feedbackError}}">商家暂未开放问卷，感谢关注。</text><view wx:if="{{feedbackError}}" class="buyer-error">{{feedbackError}}</view><button wx:if="{{feedbackError && !feedback}}" bindtap="openFeedback">重新加载</button></block>
</scroll-view></view></view>
<view wx:if="{{supportVisible}}" class="overlay support-overlay" bindtap="closeSupport">
 <view class="support-shell" catchtap="keepOrderOpen">
  <view class="support-bar"><text>联系商家</text><button bindtap="closeSupport" aria-label="关闭门店信息">×</button></view>
  <scroll-view scroll-y class="sheet support-sheet">
   <view class="support-store-name">{{shopSettings ? shopSettings.store.name : '奇迹空间'}}</view>
   <view wx:if="{{loadError}}" class="buyer-error">门店信息更新失败，请重试。</view>
   <view wx:if="{{shopSettings}}" class="support-contact">
    <text>营业时间　{{shopSettings.hoursText}}</text><text>{{shopSettings.store.detail}}</text>
    <text wx:if="{{!shopSettings.acceptingOrders}}">暂停接单</text><text wx:elif="{{!shopSettings.canOrder}}">暂未营业</text>
    <button class="text-link" bindtap="copyStoreAddress">复制地址</button>
   </view>
   <block wx:if="{{support.phone}}"><view class="support-number">{{support.phone}}</view><view class="row"><button class="primary" bindtap="callSupport">拨打电话</button><button bindtap="copySupport">复制号码</button></view></block>
   <text wx:else class="muted">暂未提供联系电话</text>
   <view class="support-rules-title">配送与售后</view>
   <view class="support-topic"><button class="support-toggle" data-section="delivery" bindtap="toggleSupportSection">快递配送<text>{{supportSection === 'delivery' ? '−' : '＋'}}</text></button>
    <view wx:if="{{supportSection === 'delivery'}}" class="support-answer"><block wx:if="{{shopSettings && shopSettings.delivery.enabled}}"><text>{{shopSettings.delivery.area}}</text><text>运费 ¥{{storeGuide.fee}}<text wx:if="{{shopSettings.delivery.minimum > 0}}"> · 满 ¥{{storeGuide.minimum}} 起送</text></text><text wx:if="{{storeGuide.freeAbove !== null}}">满 ¥{{storeGuide.freeAbove}} 免运费</text><text>{{shopSettings.delivery.estimateText || '以快递公司实际运输时效为准'}}</text><text>{{shopSettings.delivery.instructions}}</text></block><text wx:else>暂未开放快递配送</text></view>
   </view>
   <view class="support-topic"><button class="support-toggle" data-section="pickup" bindtap="toggleSupportSection">到店自提<text>{{supportSection === 'pickup' ? '−' : '＋'}}</text></button><view wx:if="{{supportSection === 'pickup'}}" class="support-answer"><block wx:if="{{shopSettings && shopSettings.pickup.enabled}}"><text>自提免费。备货完成后，出示订单到店领取。</text><text wx:if="{{shopSettings.pickup.instructions}}">{{shopSettings.pickup.instructions}}</text></block><text wx:else>暂未开放自提</text></view></view>
   <view class="support-topic"><button class="support-toggle" data-section="after" bindtap="toggleSupportSection">退货与退款<text>{{supportSection === 'after' ? '−' : '＋'}}</text></button><view wx:if="{{supportSection === 'after'}}" class="support-answer"><text>打开订单详情，选择“申请售后”。</text><text>退货请等待商家审核，按审核提供的地址寄回。</text></view></view>
  </scroll-view>
 </view>
</view>

 <scroll-view wx:if="{{loginRequired && mode!=='cloud'}}" scroll-y class="overlay login-overlay"><view class="login-layout"><view class="login-card"><text class="eyebrow">奇迹空间 · 店铺体验</text><view class="heading">欢迎来到奇迹空间</view><text class="muted">使用买家账号登录。</text><view class="field-label">账号</view><input placeholder="输入分配给你的买家账号" value="{{loginForm.username}}" data-key="username" bindinput="loginField"/><view class="field-label">密码</view><input password placeholder="输入密码" value="{{loginForm.password}}" data-key="password" bindinput="loginField" confirm-type="done" bindconfirm="login"/><button class="primary" bindtap="login" disabled="{{busy}}">进入小店 →</button><text class="muted">此登录方式不发生真实扣款。</text><button class="text-link" bindtap="toggleDataNotice">使用与数据说明 {{dataNoticeOpen ? '收起' : '展开'}}</button><view wx:if="{{dataNoticeOpen}}" class="support-topic simulation-login-notes"><text wx:for="{{simulationNotes}}" wx:key="*this">{{item}}</text></view></view></view></scroll-view>
</view>
