<view class="shell">
 <view class="notice">{{mode === 'api' ? '模拟体验 · 不发生真实付款' : (mode === 'mock' ? '开发模拟模式 · 不发生真实付款' : '微信支付')}}</view>
 <view class="brand"><view class="brand-left"><view class="brand-mark">w</view><view>爪爪小铺<text>LITTLE PAWS STORE</text></view></view><text class="store-tag">单店自营</text></view>
 <view class="nav"><button class="{{tab === 'catalog' ? 'active' : ''}}" data-tab="catalog" bindtap="tab"><image src="/assets/nav-home.png"/>首页</button><button class="{{tab === 'category' ? 'active' : ''}}" data-tab="category" bindtap="tab"><image src="/assets/nav-category.png"/>宠物百货</button><button class="{{tab === 'cart' || tab === 'checkout' ? 'active' : ''}}" data-tab="cart" bindtap="tab"><image src="/assets/nav-cart.png"/>购物车 {{cartCount || ''}}</button><button class="{{tab !== 'catalog' && tab !== 'category' && tab !== 'cart' && tab !== 'checkout' ? 'active' : ''}}" data-tab="account" bindtap="tab"><image src="/assets/nav-account.png"/>个人中心</button></view>
 <view wx:if="{{busy}}" class="request-status">正在处理，请稍候…</view>
 <view wx:if="{{loadError && !loginRequired}}" class="buyer-error"><text>{{loadError}}</text><button size="mini" bindtap="retry" disabled="{{busy}}">重新加载</button></view>
 <block wx:if="{{tab === 'catalog' || tab === 'category'}}">
  <block wx:if="{{tab === 'catalog'}}"><view class="hero"><image class="hero-image" src="{{storefront.hero}}" mode="aspectFill"/><view class="hero-copy"><text class="eyebrow">LITTLE PAWS, BIG LOVE</text><view class="headline home-headline">{{homeContent.headline}}</view><text class="hero-subtitle">{{homeContent.subtitle}}</text><button class="hero-button" data-value="全部" bindtap="browseCategory">挑一份喜欢的 →</button></view></view><view class="benefits"><text>用心选好物</text><text>单店自营</text><text>把日常过得可爱</text></view><view class="pet-gates"><view data-value="猫咪" bindtap="goPet"><view><text class="eyebrow">FOR CATS</text><view>猫咪的小天地</view><text>一起去逛逛 →</text></view><image src="{{storefront.cat}}" mode="aspectFill"/></view><view data-value="狗狗" bindtap="goPet"><view><text class="eyebrow">FOR DOGS</text><view>狗狗的快乐清单</view><text>一起去逛逛 →</text></view><image src="{{storefront.dog}}" mode="aspectFill"/></view></view><view class="section-heading"><view><text class="eyebrow">LITTLE DAILY RITUALS</text><view class="heading">照顾它的每个小日常</view></view></view><view class="scene-grid"><view wx:for="{{homeContent.scenes}}" wx:key="key" data-value="{{item.category}}" bindtap="browseCategory"><image src="/assets/{{item.image}}.jpg" mode="aspectFill"/><view><text class="eyebrow">0{{index+1}} / {{item.category}}</text><view class="scene-title">{{item.title}}</view><text>{{item.text}} →</text></view></view></view><view class="section-heading"><view><text class="eyebrow">PICKED WITH CARE</text><view class="heading">{{homeContent.featuredTitle}}</view></view><text data-value="全部" bindtap="browseCategory">全部好物 →</text></view><view class="muted">{{homeContent.featuredIntro}}</view><view class="grid home-products"><view class="card" wx:for="{{featured}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view wx:if="{{item.pickNote}}" class="pick-note">{{item.pickNote}}</view><view class="row"><view class="price">¥{{item.priceText}}</view><view class="add-small">＋</view></view></view></view></view><view wx:if="{{!featured.length}}" class="panel muted">店主正在挑选下一份好物，先去百货逛逛吧。</view><view class="new-shelf"><view class="section-heading"><view><text class="eyebrow">FRESH ON THE SHELF</text><view class="heading">{{homeContent.newTitle}}</view></view></view><scroll-view scroll-x class="new-rail"><view class="rail-inner"><view class="card" wx:for="{{latest}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view wx:if="{{item.pickNote}}" class="pick-note">{{item.pickNote}}</view><view class="row"><view class="price">¥{{item.priceText}}</view><view class="add-small">＋</view></view></view></view></view></scroll-view></view><view class="shopping-note"><text class="eyebrow">BEFORE YOU PICK</text><view class="heading">喜欢，也要合适</view><view>先看适用宠物与规格，再选尺寸和材质。给它挑一件真正用得上的好物。</view><button data-value="全部" bindtap="browseCategory">按分类慢慢挑 →</button></view></block>
  <view wx:else><view class="heading">宠物百货</view><input placeholder="搜索商品名称或描述" value="{{search}}" bindinput="searchProducts"/><view class="buyer-tools"><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortProducts"><view>{{sortOptions[sortIndex]}} ▾</view></picker><label><switch checked="{{stockOnly}}" bindchange="stockFilter" color="#284b3c"/>仅看有货</label></view></view>
  <view wx:if="{{tab === 'category'}}" class="pet-tabs"><button wx:for="{{petOptions}}" wx:key="*this" class="{{pet === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="goPet">{{item}}</button></view><view wx:if="{{tab === 'category'}}" class="catalog-layout"><scroll-view wx:if="{{tab === 'category'}}" scroll-y class="categories sidebar"><button wx:for="{{categories}}" wx:key="*this" class="{{category === item ? 'chosen' : ''}}" data-value="{{item}}" bindtap="category">{{item}}</button></scroll-view>
  <view class="grid {{tab === 'category' ? 'product-list' : ''}}"><view class="card" wx:for="{{tab === 'catalog' ? products : visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><image src="{{item.displayImage}}" mode="aspectFill"/><view class="card-copy"><text class="tag">{{item.category}} · {{item.petText}}</text><view class="title">{{item.displayName}}</view><view class="row"><view class="price"><text>¥</text>{{item.priceText}}</view><view class="add-small">＋</view></view></view></view><view wx:if="{{tab === 'category' && !visible.length}}" class="empty">好物正在准备中<view>试试其他分类吧</view></view></view></view>
 </block>
 <block wx:if="{{tab === 'cart'}}">
  <view class="heading">我的购物车</view>
  <view wx:if="{{!cart.length}}" class="empty"><image src="{{storefront.empty}}" mode="aspectFit"/><view class="empty-title">购物车还空着呢</view><button data-tab="catalog" bindtap="tab">去逛逛</button></view>
  <view wx:if="{{cart.length}}" class="row cart-select-bar"><button size="mini" bindtap="toggleAll">{{allSelected ? '☑ 全选' : '○ 全选'}}</button><text>已选 {{selectedCount}} 件</text></view>
  <view class="panel cart-item" wx:for="{{cart}}" wx:key="skuId"><button class="line-check" data-i="{{index}}" bindtap="toggleLine" aria-label="选择商品">{{item.selected ? '☑' : '○'}}</button><image src="{{item.displayImage}}" mode="aspectFill"/><view class="cart-copy"><view>{{item.name}}</view><text class="muted">{{item.spec}} · ¥{{item.priceText}}</text><view wx:if="{{item.invalid}}" class="buyer-invalid">{{item.invalid}}</view><button class="text-link" size="mini" data-i="{{index}}" bindtap="removeCart">移除商品</button><view class="row"><button size="mini" data-i="{{index}}" data-delta="-1" bindtap="qty">−</button><text>{{item.qty}}</text><button size="mini" data-i="{{index}}" data-delta="1" bindtap="qty">＋</button></view></view></view>
  <view wx:if="{{cart.length}}" class="panel"><view class="row"><text>所选商品小计</text><text class="price">¥{{cartTotal}}</text></view><text class="muted">下一步选择配送方式并核对运费。</text><button class="primary" disabled="{{busy || !selectedCount || cartInvalid}}" bindtap="prepareCheckout">去结算（{{selectedCount}} 件） →</button></view>
 </block>
 <block wx:if="{{tab === 'checkout'}}"><button class="text-link" bindtap="backCheckout">← {{checkoutSource === 'quick' ? '返回选购' : '返回购物车'}}</button><view class="heading">确认订单</view><view wx:if="{{shopNotice}}" class="buyer-error">{{shopNotice}}</view><text class="muted">{{checkoutSource === 'quick' ? '本次仅结算当前商品，购物车内容不变。' : '仅结算已勾选商品，其余商品留在购物车。'}}</text><view class="panel checkout-product" wx:for="{{checkoutLines}}" wx:key="skuId"><image src="{{item.displayImage}}" mode="aspectFill"/><view><view>{{item.name}}</view><text class="muted">{{item.spec}} × {{item.qty}}</text><view>¥{{item.lineTotalText}}</view><text wx:if="{{item.invalid}}" class="buyer-invalid">{{item.invalid}}</text></view></view>
<view class="panel fulfillment-choice"><text class="eyebrow">HOW TO GET YOUR GOODIES</text><view class="section-title">这次，怎么带回家？</view><view class="mode-tabs"><button class="{{deliveryMode === 'DELIVERY' ? 'selected' : ''}}" disabled="{{busy || !deliveryEnabled}}" data-value="DELIVERY" bindtap="deliveryMode">商家外送<text>由小店安排送达</text></button><button class="{{deliveryMode === 'PICKUP' ? 'selected' : ''}}" disabled="{{busy || !pickupEnabled}}" data-value="PICKUP" bindtap="deliveryMode">到店自提<text>顺路来店里坐坐</text></button></view><view wx:if="{{deliveryMode === 'PICKUP'}}"><view class="store-ticket"><text class="eyebrow">PICK UP HERE</text><view class="section-title">{{pickupStore.name}}</view><view>{{pickupStore.detail}}</view><text>{{pickupStore.hours}} · 自提免配送费</text><view wx:if="{{shopSettings.pickup.instructions}}" class="muted">{{shopSettings.pickup.instructions}}</view></view><view class="field-label">提货人</view><input placeholder="提货人称呼" value="{{pickupContact.name}}" data-key="name" bindinput="pickupField"/><view class="field-label">联系电话</view><input placeholder="11 位手机号" type="number" maxlength="11" value="{{pickupContact.phone}}" data-key="phone" bindinput="pickupField"/></view><view wx:else><view class="row"><view class="section-title">送到这里</view><button class="text-link" bindtap="openAddresses">选择 / 新增地址 →</button></view><view wx:if="{{selectedAddress}}" class="address-select" bindtap="openAddresses"><view class="checkout-person">{{selectedAddress.name}}<text>{{selectedAddress.phone}}</text></view><view>{{selectedAddress.detail}}</view><text>点击更换收货地址 ›</text></view><button wx:else class="address-add" bindtap="openAddresses">＋ 添加收货地址</button><text class="muted">{{shopSettings.delivery.area}} {{shopSettings.delivery.instructions}}</text></view><view class="checkout-summary"><view class="row"><text>商品小计</text><text>¥{{cartTotal}}</text></view><view class="row"><text>{{deliveryMode === 'PICKUP' ? '到店自提' : '商家外送费'}}</text><text>{{deliveryMode === 'PICKUP' ? '免费' : '¥' + shippingEstimate}}</text></view><view class="row buyer-total"><text>预计合计</text><text>¥{{checkoutTotal}}</text></view><text class="muted">费用按当前门店设置计算，提交前将再次核对。</text></view><button class="primary" disabled="{{busy || cartInvalid || !canOrder}}" bindtap="checkout">{{deliveryMode === 'DELIVERY' && !selectedAddress ? '添加地址后下单 →' : (deliveryMode === 'PICKUP' ? '提交自提订单 →' : '提交外送订单 →')}}</button></view></block>
<block wx:if="{{tab === 'account'}}"><view class="member-card"><view class="member-top"><text>MY ORDERS</text><text class="member-pill">订单与收货信息</text></view><view class="member-person"><image src="{{storefront.avatar}}" mode="aspectFill"/><view><view class="member-name">你好，宠物家长</view><text>每一份小心意，都为它准备。</text></view></view><view class="member-footer"><text>爪爪小铺 · 我的日常</text><text>WITH LOVE ♡</text></view></view><view class="panel account-orders"><view class="row"><view class="section-title">我的订单</view><button class="text-link" data-tab="orders" bindtap="tab">全部订单 →</button></view><view class="order-quick"><button data-status="PENDING" bindtap="orderFilter"><view class="quick-icon">◷</view>待付款</button><button data-status="PAID" bindtap="orderFilter"><view class="quick-icon"><image src="/assets/nav-category.png"/></view>待备货</button><button data-status="SHIPPED" bindtap="orderFilter"><view class="quick-icon"><image src="/assets/nav-cart.png"/></view>配送中</button><button data-status="AFTERSALE" bindtap="orderFilter"><view class="quick-icon">♡</view>售后</button></view></view><view class="service-pair"><button data-value="PICKUP" bindtap="fulfillmentOrders"><image src="/assets/nav-home.png"/><view>我的自提</view><text>备货进度 · 到店提货码</text><text class="service-arrow">↗</text></button><button data-value="DELIVERY" bindtap="fulfillmentOrders"><image src="/assets/nav-cart.png"/><view>我的外送</view><text>商家配送 · 单号与进度</text><text class="service-arrow">↗</text></button></view><view class="panel service-menu"><button bindtap="openSupport"><view class="menu-icon">☎</view><view><view>联系商家 / 购买说明</view><text>配送、自提与售后帮助</text></view><text class="menu-arrow">›</text></button><button bindtap="openAddresses"><view class="menu-icon">⌖</view><view><view>我的地址簿</view><text>把好物送到熟悉的地方</text></view><text class="menu-arrow">›</text></button></view><view class="quiet-note">一间小店，认真照顾每个小日常。<view wx:if="{{mode!=='cloud'}}">演示账号 · 无真实付款</view><button wx:if="{{mode!=='cloud'}}" class="text-link" bindtap="logout">退出测试账号</button></view></block>
<block wx:if="{{tab === 'addresses'}}"><view class="page-intro"><button class="text-link" bindtap="backAddresses">← {{addressReturn === 'checkout' ? '返回确认订单' : (addressReturn === 'cart' ? '返回购物车' : '个人中心')}}</button><text class="eyebrow">YOUR LITTLE PLACES</text><view class="heading">我的地址簿 <text>{{addresses.length}}</text></view><text>家的方向，和每一份期待。</text></view><view class="address-card" wx:for="{{addresses}}" wx:key="id"><view class="row"><view class="address-pin">⌖</view><text class="tag">外送收货地点</text></view><view class="address-detail">{{item.detail}}</view><view class="address-person">{{item.name}}<text>{{item.phone}}</text></view><view class="address-bottom"><button wx:if="{{addressReturn === 'cart' || addressReturn === 'checkout'}}" data-i="{{index}}" bindtap="useAddress">用这个地址</button><button data-i="{{index}}" bindtap="editAddress">编辑地址</button><button class="text-link" data-id="{{item.id}}" bindtap="deleteAddress">删除</button></view></view><view wx:if="{{!addresses.length}}" class="address-empty"><view>⌖</view><view class="section-title">先记下一个熟悉的地方</view><text>添加地址，下次外送就不用再填写了。</text></view><button class="primary new-address" bindtap="newAddress">＋ 添加收货地址</button><view class="quiet-note">仅外送需要地址，到店自提无需填写。<view>模拟环境请使用虚构信息</view></view></block>
<view wx:if="{{addressEditing}}" class="overlay"><scroll-view scroll-y class="sheet address-editor"><button class="close" bindtap="closeAddress">×</button><text class="eyebrow">ADDRESS BOOK</text><view class="heading">{{addressForm.id ? '编辑地址' : '添加一个收货地点'}}</view><text class="muted">让毛孩子的好物，准确送到你身边。</text><view class="field-label">收货人</view><input placeholder="怎么称呼你" maxlength="40" value="{{addressForm.name}}" data-key="name" bindinput="field"/><view class="field-label">联系电话</view><input placeholder="11 位手机号码" type="number" maxlength="11" value="{{addressForm.phone}}" data-key="phone" bindinput="field"/><view class="field-label">详细地址</view><textarea placeholder="省、市、区、街道及门牌号" maxlength="200" value="{{addressForm.detail}}" data-key="detail" bindinput="field"/><view class="quiet-note">当前为模拟环境，请填写虚构资料。</view><button class="primary" bindtap="saveAddress" disabled="{{busy}}">保存这个地址</button></scroll-view></view>
 <block wx:if="{{tab === 'orders'}}"><view class="row"><view class="heading">我的订单</view><button class="text-link" bindtap="searchOrders" disabled="{{busy}}">刷新订单</button></view><scroll-view scroll-x class="order-quick-tabs"><view class="order-quick-inner"><button wx:for="{{orderQuickOptions}}" wx:key="id" class="{{orderStatus === item.id ? 'chosen' : ''}}" data-status="{{item.id}}" bindtap="orderFilter">{{item.name}}</button></view></scroll-view><view class="mode-tabs order-modes"><button wx:for="{{fulfillmentOptions}}" wx:key="id" class="{{fulfillmentFilter === item.id ? 'selected' : ''}}" data-value="{{item.id}}" bindtap="fulfillmentFilter">{{item.name}}</button></view><view class="panel"><input placeholder="订单号或商品名称" maxlength="80" value="{{orderQuery}}" bindinput="orderQueryField"/><picker range="{{orderStatusOptions}}" range-key="name" value="{{orderStatusIndex}}" bindchange="orderStatusField"><view>状态：{{orderStatusOptions[orderStatusIndex].name}} ▾</view></picker><button bindtap="searchOrders" disabled="{{busy}}">查询订单</button><view>共 {{orderTotal}} 单 · 第 {{orderPageNumber}} / {{orderPages}} 页</view><view class="row"><button size="mini" data-delta="-1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber <= 1}}">上一页</button><button size="mini" data-delta="1" bindtap="turnOrderPage" disabled="{{busy || orderPageNumber >= orderPages}}">下一页</button></view></view><view wx:if="{{!orders.length}}" class="empty">暂无订单</view><view class="panel order-list-card" wx:for="{{orders}}" wx:key="id" wx:for-item="purchase" data-id="{{purchase.id}}" bindtap="showOrder"><view class="row"><text class="order-small">{{purchase.fulfillmentText}} · {{purchase.id}}</text><text class="tag">{{purchase.statusText}}</text></view><view class="order-preview-line" wx:for="{{purchase.lines}}" wx:key="skuId"><image src="{{item.displayImage}}" mode="aspectFill"/><view><view>{{item.name}}</view><text class="muted">{{item.spec}} × {{item.qty}}</text></view><text>¥{{item.lineTotalText}}</text></view><view wx:if="{{purchase.issueInfo && purchase.issueInfo.status === 'OPEN'}}" class="buyer-issue-note">{{purchase.issueInfo.note}}</view><view class="order-small">{{purchase.createdText}} · 共 {{purchase.itemCount}} 件</view><view wx:if="{{purchase.status === 'PENDING'}}" class="order-clock">{{purchase.payExpired ? purchase.remainingText : '剩余付款时间 ' + purchase.remainingText}}</view><view class="row"><text class="order-small">查看订单详情 ›</text><view class="price">¥{{purchase.totalText}}</view></view></view></block>

 <view wx:if="{{detail}}" class="overlay"><scroll-view scroll-y class="sheet"><button class="close" bindtap="close">×</button><swiper class="detail-gallery" indicator-dots="{{detail.gallery.length > 1}}"><swiper-item wx:for="{{detail.gallery}}" wx:key="*this"><image class="detail-art" src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="detail-intro"><view class="tag">样例商品 · 单店精选</view><view class="heading">{{detail.displayName}}</view><text class="description">{{detail.description}}</text></view><picker range="{{detail.skus}}" range-key="name" value="{{skuIndex}}" bindchange="spec"><view class="panel">规格：{{detail.skus[skuIndex].name}} ▾</view></picker><view class="price">¥{{detail.skus[skuIndex].priceText}}</view><text>可售库存 {{detail.skus[skuIndex].stock}}</text><view class="row"><text>数量</text><button size="mini" data-delta="-1" bindtap="detailQty">−</button><text>{{detailQty}}</text><button size="mini" data-delta="1" bindtap="detailQty">＋</button></view><view class="detail-actions"><button class="black" disabled="{{!detail.skus[skuIndex].stock}}" bindtap="add">加入购物车</button><button class="primary" disabled="{{!detail.skus[skuIndex].stock}}" bindtap="buy">立即购买</button></view></scroll-view></view>
 <view wx:if="{{selectedOrder}}" class="overlay"><scroll-view scroll-y class="sheet"><view class="row"><button bindtap="close">关闭详情</button><button size="mini" bindtap="refreshOrder" disabled="{{busy}}">刷新订单</button></view><view class="heading">{{selectedOrder.statusText}}</view><view class="order-next"><text class="eyebrow">下一步</text><view>{{selectedOrder.nextStep}}</view></view><view wx:if="{{selectedOrder.issueInfo}}" class="buyer-issue"><view class="row"><view class="section-title">{{selectedOrder.issueInfo.title}}</view><text>{{selectedOrder.issueInfo.statusText}}</text></view><view>{{selectedOrder.issueInfo.note}}</view><view wx:if="{{selectedOrder.issueInfo.nextText && selectedOrder.issueInfo.status === 'OPEN'}}" class="issue-appointment">约定处理时间：{{selectedOrder.issueInfo.nextText}}</view><view class="issue-history" wx:for="{{selectedOrder.issueInfo.timeline}}" wx:key="key"><view>{{item.label}} · {{item.actor}}</view><text>{{item.timeText}}</text><view>{{item.detail}}</view><view wx:if="{{item.nextText}}">约定时间：{{item.nextText}}</view></view><button size="mini" bindtap="openSupport">联系商家</button></view><view class="row order-meta"><text>订单 {{selectedOrder.id}}</text><button size="mini" bindtap="copyOrderNumber">复制订单号</button></view><view class="order-meta">下单时间：{{selectedOrder.createdText}}</view><view wx:if="{{selectedOrder.status === 'PENDING'}}" class="order-deadline">{{selectedOrder.payExpired ? selectedOrder.remainingText : '剩余付款时间 ' + selectedOrder.remainingText}}<view>付款截止：{{selectedOrder.expiresText}}</view><view>超时自动取消并释放库存</view></view><view class="order-meta">状态更新时间：{{selectedOrder.updatedText}}</view><view class="panel" wx:for="{{selectedOrder.lines}}" wx:key="skuId">{{item.name}} / {{item.spec}} × {{item.qty}}<view class="order-line-price">¥{{item.unitText}} / 件 · 小计 ¥{{item.lineTotalText}}</view></view><view class="fulfillment-card"><view class="fulfillment-top"><image src="{{selectedOrder.isPickup ? '/assets/nav-home.png' : '/assets/nav-cart.png'}}"/><view><text class="eyebrow">{{selectedOrder.isPickup ? 'PICK UP IN STORE' : 'DELIVERED BY OUR SHOP'}}</text><view class="section-title">{{selectedOrder.fulfillmentText}}</view></view></view><view class="fulfillment-body"><view class="section-title">{{selectedOrder.isPickup ? selectedOrder.fulfillment.store.name : selectedOrder.address.detail}}</view><view wx:if="{{selectedOrder.isPickup}}" class="muted">{{selectedOrder.fulfillment.store.detail}}<view>{{selectedOrder.fulfillment.store.hours}}</view></view><view class="muted">{{selectedOrder.address.name}} · {{selectedOrder.address.phone}}</view><view wx:if="{{selectedOrder.isPickup && selectedOrder.status === 'PAID' && !merchant}}" class="pickup-pass"><text>{{selectedOrder.issueInfo && selectedOrder.issueInfo.status === 'OPEN' ? '请按协商结果安排到店' : (selectedOrder.fulfillment.readyAt ? '已备好，可以来取啦' : '正在备货，请稍候到店')}}</text><view>{{selectedOrder.fulfillment.code}}</view><text>到店后向商家出示提货码</text></view><view wx:if="{{!selectedOrder.isPickup && selectedOrder.shipping}}" class="delivery-slip"><text>商家配送单号</text><view>{{selectedOrder.shipping.number || '未填写单号'}}</view><button wx:if="{{selectedOrder.shipping.number}}" size="mini" bindtap="copyTracking">复制配送单号</button><text>{{selectedOrder.shipping.note}}</text></view><view class="fulfillment-progress">下单 → 备货 → {{selectedOrder.isPickup ? '到店自提' : '商家送达'}} → 完成</view></view></view><view class="order-money"><view class="row"><text>商品金额</text><text>¥{{selectedOrder.subtotalText}}</text></view><view class="row"><text>{{selectedOrder.isPickup ? '到店自提' : '商家外送费'}}</text><text>¥{{selectedOrder.shippingText}}</text></view><view class="row"><text>{{selectedOrder.amountLabel}}</text><view class="price">¥{{selectedOrder.totalText}}</view></view><text class="muted">{{selectedOrder.paymentNotice}}</text></view><text>{{selectedOrder.isPickup ? '自提免配送费' : '含商家外送费 ¥' + selectedOrder.shippingText}}</text><view wx:if="{{selectedOrder.status === 'PENDING'}}"><text>15 分钟未付款自动超时释放库存</text><button class="primary" disabled="{{busy || selectedOrder.payExpired}}" data-action="{{mode !== 'cloud' ? 'mockPay' : 'payment'}}" bindtap="action">{{mode !== 'cloud' ? '模拟付款（不扣款）' : '微信支付'}}</button><button data-action="cancel" bindtap="action">取消订单</button></view><button wx:if="{{selectedOrder.status === 'SHIPPED'}}" data-action="confirmReceipt" bindtap="action">确认收货</button><view class="row"><button bindtap="tracking" disabled="{{busy}}">查看履约记录</button><button bindtap="openSupport">联系商家</button></view><text class="muted">配送状态由商家登记，暂不提供骑手位置或自动物流轨迹。</text><view wx:if="{{tracking}}" class="panel"><view>{{tracking.company}} {{tracking.number}}</view><view>{{tracking.note}}</view><text>{{tracking.notice}}</text><view wx:for="{{tracking.events}}" wx:key="time">{{item.timeText}} · {{item.text}}</view></view><view class="panel" wx:if="{{!merchant && (selectedOrder.status === 'PAID' || selectedOrder.status === 'SHIPPED' || selectedOrder.status === 'COMPLETED')}}"><view class="heading">申请售后</view><text>{{selectedOrder.refundNotice}}</text><picker wx:if="{{selectedOrder.status !== 'PAID'}}" range="{{afterTypes}}" value="{{afterForm.type === 'REFUND_ONLY' ? 1 : 0}}" bindchange="afterType"><view>售后类型：{{afterForm.type === 'REFUND_ONLY' ? '仅退款' : '退货退款'}}（点击选择）</view></picker><textarea placeholder="请填写售后原因" maxlength="300" value="{{afterForm.reason}}" data-key="reason" bindinput="afterField"/><button disabled="{{busy}}" data-action="refundRequest" bindtap="action">提交售后申请</button></view>
<view wx:if="{{selectedOrder.refund}}" class="panel"><view class="heading">{{selectedOrder.refund.stageText}}</view><view>售后单 {{selectedOrder.refund.caseId}}</view><view>{{selectedOrder.refund.type === 'RETURN_REFUND' ? '退货退款' : '仅退款'}} · ¥{{selectedOrder.refund.amountText}}</view><view>申请原因：{{selectedOrder.refund.reason}}</view><view wx:if="{{selectedOrder.refund.review}}">审核意见：{{selectedOrder.refund.review.note}}</view><view wx:if="{{selectedOrder.refund.returnAddress}}">退货至：{{selectedOrder.refund.returnAddress.name}} {{selectedOrder.refund.returnAddress.phone}} {{selectedOrder.refund.returnAddress.detail}}</view><view wx:if="{{selectedOrder.refund.returnShipping}}">退货物流：{{selectedOrder.refund.returnShipping.company}} {{selectedOrder.refund.returnShipping.number}}</view>
<button wx:if="{{!merchant && selectedOrder.refund.stage === 'REQUESTED'}}" disabled="{{busy}}" data-action="refundWithdraw" bindtap="action">撤回申请</button>

<view wx:if="{{!merchant && selectedOrder.refund.stage === 'WAIT_RETURN'}}"><text>模拟运单，提交后锁定，请核对。</text><input placeholder="退货快递公司" data-key="company" bindinput="afterField"/><input placeholder="退货单号" data-key="number" bindinput="afterField"/><button disabled="{{busy}}" data-action="returnShip" bindtap="action">提交退货物流</button></view>

<view wx:if="{{selectedOrder.refund.inspection}}"><view wx:for="{{selectedOrder.refund.inspection.items}}" wx:key="skuId">{{item.name}} / {{item.spec}}：实收 {{item.receivedQty}} · 可售 {{item.restockQty}} · 隔离 {{item.quarantineQty}} · 缺件 {{item.missingQty}}</view><view>验收说明：{{selectedOrder.refund.inspection.note}}</view></view>
<view wx:if="{{selectedOrder.refund.failureReason}}">上次退款失败：{{selectedOrder.refund.failureReason}}</view>
<view wx:for="{{selectedOrder.refund.timeline}}" wx:key="index" class="panel"><view>{{item.timeText}} · {{item.actor}} · {{item.label}}</view><text>{{item.detail}}</text></view></view><view wx:for="{{selectedOrder.refundHistory}}" wx:key="caseId" class="panel">历史售后 {{item.caseId}} · {{item.reason}} · {{item.review.note}}</view></scroll-view></view>





<view wx:if="{{supportVisible}}" class="overlay support-overlay">
 <scroll-view scroll-y class="sheet support-sheet">
  <button class="close" bindtap="closeSupport" aria-label="关闭门店信息">×</button>
  <text class="eyebrow">门店信息</text><view class="heading">{{shopSettings ? shopSettings.store.name : '联系商家'}}</view>
  <view wx:if="{{shopSettings && shopSettings.revision === 0}}" class="quiet-note">当前使用示例门店资料，仅供模拟测试，请勿实际到店或寄件。</view>
  <view wx:if="{{loadError}}" class="buyer-error">门店信息未能更新，以下内容可能已变更。下单前请重新加载或联系商家确认。</view>
  <view wx:if="{{shopSettings}}" class="support-topic">
   <view class="section-title">{{shopSettings.store.detail}}</view>
   <text>营业时间：{{shopSettings.hoursText}}</text>
   <text wx:if="{{!shopSettings.acceptingOrders}}">门店暂停接单</text>
   <text wx:elif="{{!shopSettings.canOrder}}">当前不在接单时间内</text>
   <button class="text-link" bindtap="copyStoreAddress">复制门店地址</button>
  </view>
  <block wx:if="{{support.phone}}"><view class="support-number">{{support.phone}}</view><text wx:if="{{support.hours && !shopSettings}}" class="muted">服务时间：{{support.hours}}</text><view class="row"><button class="primary" bindtap="callSupport">拨打电话</button><button bindtap="copySupport">复制号码</button></view></block>
  <view wx:else class="panel muted">店铺尚未配置联系电话。咨询订单问题时，可先在订单详情复制订单号，通过已有的商家联系渠道咨询。</view>
  <view class="support-topic">
   <view class="section-title">商家外送<text class="support-status" wx:if="{{shopSettings}}">{{shopSettings.delivery.enabled ? '已开放' : '暂未开放'}}</text></view>
   <block wx:if="{{shopSettings && shopSettings.delivery.enabled}}">
    <text>外送范围：{{shopSettings.delivery.area}}</text>
    <text>外送费：¥{{storeGuide.fee}}<text wx:if="{{shopSettings.delivery.minimum > 0}}"> · 商品满 ¥{{storeGuide.minimum}} 起送</text></text>
    <text wx:if="{{storeGuide.freeAbove !== null}}">商品满 ¥{{storeGuide.freeAbove}} 免外送费，以结算页为准。</text>
    <text>预计送达：{{shopSettings.delivery.estimateMinutes}} 分钟，实际安排请以商家通知为准。</text>
    <text wx:if="{{shopSettings.delivery.instructions}}">{{shopSettings.delivery.instructions}}</text>
   </block>
   <text wx:elif="{{!shopSettings}}">外送范围和费用尚未加载，请先重新加载门店信息。</text>
   <text>由商家自行安排配送；送出后可在订单详情查看单号及备注。</text>
  </view>
  <view class="support-topic">
   <view class="section-title">到店自提<text class="support-status" wx:if="{{shopSettings}}">{{shopSettings.pickup.enabled ? '已开放' : '暂未开放'}}</text></view>
   <text wx:if="{{shopSettings && shopSettings.pickup.enabled && shopSettings.pickup.instructions}}">{{shopSettings.pickup.instructions}}</text>
   <text>请等订单显示可提货后，按订单中保存的门店信息到店，向商家出示提货码。自提不收外送费。</text>
  </view>
  <view class="support-topic"><view class="section-title">售后处理</view><text>在订单详情填写原因申请售后。退货请先等审核通过，核对商家提供的退货地址后再寄出；不要寄到示例地址。</text></view>
  <view class="support-topic"><view class="section-title">使用与数据说明</view><text wx:for="{{simulationNotes}}" wx:key="*this">{{item}}</text></view>
 </scroll-view>
</view>
 <scroll-view wx:if="{{loginRequired && mode!=='cloud'}}" scroll-y class="overlay login-overlay"><view class="login-layout"><view class="login-card"><text class="eyebrow">爪爪小铺 · 模拟体验</text><view class="heading">欢迎来到爪爪小铺</view><text class="muted">使用买家测试账号登录，订单会保存到共享联调服务。</text><view class="field-label">测试账号</view><input placeholder="输入分配给你的买家账号" value="{{loginForm.username}}" data-key="username" bindinput="loginField"/><view class="field-label">密码</view><input password placeholder="输入测试密码" value="{{loginForm.password}}" data-key="password" bindinput="loginField" confirm-type="done" bindconfirm="login"/><button class="primary" bindtap="login" disabled="{{busy}}">进入小店 →</button><text class="muted">仅供模拟测试，不发生真实支付。</text><button class="text-link" bindtap="toggleDataNotice">模拟使用与数据说明 {{dataNoticeOpen ? '收起' : '展开'}}</button><view wx:if="{{dataNoticeOpen}}" class="support-topic simulation-login-notes"><text wx:for="{{simulationNotes}}" wx:key="*this">{{item}}</text></view></view></view></scroll-view>
</view>
