.buyer-tools{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin:24rpx 0;font-size:24rpx;color:#61755b}.buyer-tools label{display:flex;align-items:center}.buyer-tools switch{transform:scale(.7);margin-right:-8rpx}.buyer-invalid{color:#a34f38;background:#fff0e7;padding:12rpx;border-radius:12rpx;font-size:22rpx;margin:12rpx 0}.buyer-total{font-weight:700;color:#284b3c;font-size:32rpx!important}.buyer-error{background:#fff1df;color:#8b512f;padding:24rpx;border-radius:20rpx;font-size:24rpx;margin:20rpx 0}.buyer-error button{margin-top:16rpx}

/* Selected cart and dedicated checkout */
.cart-select-bar{font-size:24rpx;margin-bottom:20rpx}.line-check{flex-shrink:0!important;width:44rpx!important;min-width:44rpx;padding:0!important;margin:0!important;background:transparent!important;color:#284b3c;font-size:36rpx!important}.checkout-product{display:flex;gap:24rpx;font-size:27rpx;line-height:1.7}.checkout-product image{width:130rpx;height:130rpx;border-radius:18rpx;flex-shrink:0}.checkout-person{font-weight:600;margin-bottom:16rpx}.checkout-person text{display:inline!important;font-size:25rpx!important;color:#52694c!important;margin-left:20rpx}.address-add{width:100%;padding:24rpx;border:1rpx dashed #bdcbb2;background:#f4f7ed;border-radius:18rpx}.order-meta{font-size:23rpx;line-height:1.8;color:#7d8873;word-break:break-all;margin:16rpx 0}.order-meta button{font-size:20rpx;margin:0;padding:8rpx 12rpx}.order-deadline{background:#f6eddd;border-radius:16rpx;padding:20rpx;font-size:25rpx;color:#87612f;line-height:1.8}.order-deadline view{font-size:22rpx}.order-line-price{font-size:23rpx;color:#7b8770;margin-top:14rpx}.order-money{border-top:1rpx solid #e1e8d9;padding-top:20rpx;margin:25rpx 0}.order-money .row{margin:20rpx 0;font-size:26rpx}

/* Order progress and buyer support */
.order-quick-tabs{white-space:nowrap;margin:18rpx 0}.order-quick-inner{display:flex;gap:12rpx}.order-quick-inner button{flex-shrink:0;margin:0;padding:12rpx 24rpx;font-size:23rpx;background:#edf2e5}.order-quick-inner .chosen{background:#284b3c;color:#fff}.order-preview-line{display:flex;align-items:center;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #edf0e7}.order-preview-line image{width:100rpx;height:100rpx;border-radius:14rpx;flex-shrink:0}.order-preview-line>view{flex:1;min-width:0;font-size:24rpx}.order-preview-line>text{font-size:23rpx}.order-small{font-size:21rpx;color:#86907d;line-height:1.8;margin:14rpx 0;word-break:break-all}.order-clock{color:#98682f;font-size:24rpx;padding:12rpx 0}.order-next{background:#edf3e7;border-radius:20rpx;padding:24rpx;margin:20rpx 0;line-height:1.8;font-size:25rpx;color:#4e6848}.order-next .eyebrow{font-size:19rpx}.support-overlay{z-index:95}.support-sheet{box-sizing:border-box;padding-top:65rpx}.support-number{font-size:42rpx;letter-spacing:2rpx;margin:24rpx 0;color:#284b3c}.support-topic{border-top:1rpx solid #e1e7da;margin-top:28rpx;padding-top:20rpx;font-size:25rpx;line-height:1.9;color:#718067}

.buyer-issue{background:#faf6ed;border-left:5rpx solid #a07844;border-radius:14rpx;padding:24rpx;margin:26rpx 0;font-size:25rpx;line-height:1.9;color:#655e48}.buyer-issue .section-title{font-size:28rpx;margin:0}.buyer-issue .row>text{font-size:22rpx}.issue-appointment{font-weight:600;margin:16rpx 0}.issue-history{border-top:1rpx solid #e4dfce;margin-top:20rpx;padding-top:16rpx}.issue-history text{font-size:20rpx;color:#88836d}.buyer-issue button{margin-top:20rpx}.buyer-issue-note{background:#faf3e7;padding:12rpx 16rpx;font-size:22rpx;color:#87612f;border-radius:10rpx}

.support-topic>text{display:block;white-space:pre-wrap;word-break:break-all;margin-top:10rpx}.support-status{display:inline-block;margin-left:18rpx;padding:2rpx 12rpx;border-radius:8rpx;background:#edf1e9;color:#52614f;font-size:21rpx;font-weight:400}

.login-card .simulation-login-notes{margin-top:12rpx;font-size:24rpx;text-align:left}.login-card .simulation-login-notes>text{margin:14rpx 0}

/* Keep request feedback out of document flow so buttons do not move during loading. */
.request-status{position:fixed;top:0;left:0;right:0;z-index:100;box-sizing:border-box;padding:10rpx 16rpx;background:#e9eee5;color:#536456;text-align:center;font-size:20rpx;line-height:1.6;pointer-events:none}
